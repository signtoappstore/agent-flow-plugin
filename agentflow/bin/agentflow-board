#!/usr/bin/env python3
"""AgentFlow board tool — setup + diagnostics over GitHub GraphQL/REST (stdlib only).

Runtime ticket work goes through GitHub MCP; this tool covers what MCP cannot do (edit Status
options, create fields/views, link repo) and read-only reports that would be expensive via MCP
(pipeline checks, people's feedback on a PR).
Auth: the token `gh` uses ($GH_TOKEN, $GITHUB_TOKEN, else `gh auth token`). Never prints the token.

  whoami                                    login + token scopes; exit 1 when the token lacks a scope of FULL_SCOPES
  inspect <board-url> [--done NAME] [--repo O/R]   fields/options/views/repos + item count per Status
  items <board-url> [--open] [--fields A,B] [--repo O/R]  one compact line per item
  status-plan <board-url> --want A,B,..     show what apply would change (no write)
       [--rename Old=New ...] [--drop-extra] [--describe]
  status-apply <board-url> --want ... --yes apply (option ids preserved — cards keep values)
       [--allow-drop]                       needed to remove an option that still holds cards
  ensure-field <board-url> --name N --options a,b,..   create single-select field if missing
  platform-migrate <board-url> --repo O/R [--field Platform] [--map Option=label ...] [--yes] [--drop-field]
                                            board field Platform → labels.platform on each issue; plan without --yes
  create --owner O --owner-type org|user --title T --repo O/R --want A,B,..
       [--field Name=a,b,..]... [--sprint DAYS] [--description TXT] [--readme FILE]
  repo <owner/repo>                         canonical name, owner type, default branch
  milestones <owner/repo>                   open milestones, nearest due date first (/agentflow:task)
  labels --repo O/R --label name|color|description ...   create or update
  issue-types --org O [--ensure Name|description ...]
  metrics <board-url> [--days N] [--stages k=v,...] [--parked l1,l2,...]
  checks <owner/repo> --branch B --contains SHA [--since ISO] [--wait MIN] [--skip GLOB]   CI of the branch head; one JSON line
                                            (queued: its run waits behind another run of its concurrency group)
  workflows <owner/repo>                    the boolean inputs of each staging.workflows entry, with their descriptions
  dispatch <owner/repo> [--on IN,..] [--workflow FILE] [--qc] [--issue N] [--force]
                                            run a workflow of staging.workflows on staging.branch: the inputs of --on true,
                                            every other boolean input false. Without --on (and --force) nothing runs when the
                                            last deploy already holds every change of the staging head it must build
                                            (afconfig.release_paths): `dispatched: []` + `deployed`. An older unfinished
                                            deploy of the same workflow dispatched here that turned on no more is
                                            cancelled. --qc: the build for a
                                            person's QC (inputs = state qc_release), kept from cancel. An input that wipes
                                            staging data needs --issue, refused (exit 5) while another ticket is In QC or
                                            runs flows on this machine
  rerun <owner/repo> [--run ID]             re-run failed jobs of runs on staging.branch (default: the runs of its head);
                                            at most MAX_RERUNS re-runs per run
  cancel <owner/repo> [--run ID]            cancel unfinished runs on staging.branch whose commit is not its head and
                                            that a push or a deploy dispatched here started; a wipe (1 h) or a QC build
                                            (3 h) is kept
  group <owner/repo> --issue N [--issue M ...]   sub-issues of each issue and the parent whose one PR carries it
  group-sync <owner/repo> --issue N         the sub-issues of group N (state block `group`) take the Status of N
  feedback <owner/repo> --issue N [--issue M ...] [--summary]   people's feedback on the PR of each issue
       (state block `pr`, else the one open PR linked to it); one JSON line per issue
  precheck <owner/repo> --issue N [--pr M]  before DEV hands a PR to review: draft, base, conflict, `<git.link> #n`, AC
                                            checklist, sections of dev.md §6 + the repo's PR template, every e2e/api TC of
                                            `[AF:SA] design` named, the "Đỏ trước" line; one JSON line, exit 1 on a problem
  doctor [--root DIR]                       check agentflow.yaml against GitHub
  preflight [--root DIR]                    before spawning: can this machine push to origin, which env is missing;
                                            one JSON line
"""

import argparse
import base64
import datetime as dt
import fnmatch
import glob
import json
import os
import re
import shutil
import statistics
import subprocess
import sys
import time
import urllib.parse

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "scripts"))
import afconfig  # noqa: E402

API = os.environ.get("AGENTFLOW_GITHUB_API") or "https://api.github.com"  # GitHub Enterprise, or the fake one of tests/e2e
STATUS_COLORS = {"backlog": "GRAY", "ready": "BLUE", "in_progress": "YELLOW", "in_review": "ORANGE",
                 "in_qc": "PINK", "ready_to_merge": "PURPLE", "done": "GREEN"}
STATUS_DESC = {
    "backlog": "Ý tưởng, yêu cầu, bug mới. PO viết tiêu chí nghiệm thu, đặt Priority/Size rồi kéo sang Ready.",
    "ready": "Đủ tiêu chí nghiệm thu, có Priority + Size, chỉ PO kéo việc mới vào. SA agent thiết kế giải pháp + rủi ro + test case (nhãn agentflow), rồi DEV nhặt. Nhãn qc-failed = QC người trả về.",
    "in_progress": "DEV code + viết flow automation (flow mới phải đỏ trên bản chưa có thay đổi), mở draft PR, hoặc sửa theo review/QC (nhãn changes-requested / qc-failed).",
    "in_review": "SA agent review code theo thiết kế (đúng, đủ, kiến trúc, bảo mật, test). ✅ code: DEV deploy staging + chạy flow liên quan (tự sửa tối đa 3 vòng), SA chốt: có mục QC tay thì sang In QC, không thì undraft.",
    "in_qc": "Nhãn qc-manual = chờ QC người test mục QC tay của PR trên staging. Pass: tick rồi kéo card sang Ready to Merge; fail: gắn qc-failed + comment.",
    "ready_to_merge": "Review + QC đã pass, PR đã undraft. Người approve + merge. Muốn sửa: Request changes trên PR.",
    "done": "PR đã merge, issue đã đóng.",
}
# Token phải có mọi scope top-level của classic token (người dùng chọn 2026-11-12, DESIGN-NOTES.md), trừ delete_repo và
# admin:enterprise (bỏ 2026-11-25: plugin không dùng, guard chặn xoá repo). X-OAuth-Scopes trả danh sách đã chuẩn hoá:
# scope cha thay cho scope con, nên so từng tên top-level là đủ.
FULL_SCOPES = ("repo", "workflow", "write:packages", "delete:packages", "admin:org", "admin:public_key", "admin:repo_hook",
               "admin:org_hook", "gist", "notifications", "user", "write:discussion",
               "audit_log", "codespace", "copilot", "write:network_configurations", "project", "admin:gpg_key",
               "admin:ssh_signing_key")
CLASSIC_TOKEN_URL = "https://github.com/settings/tokens/new?description=agentflow&scopes=" + ",".join(FULL_SCOPES)
RETRY_STATUS = (429, 502, 503, 504)
_TOKEN = None


def die(msg, code=1):
    sys.stderr.write("agentflow-board: %s\n" % msg)
    sys.exit(code)


def token():
    global _TOKEN
    if _TOKEN is None:
        _TOKEN = afconfig.github_token()
        if not _TOKEN:
            die("gh chưa có token — gh auth login -h github.com -s %s" % ",".join(FULL_SCOPES), 3)
    return _TOKEN


def token_scopes(headers):
    """Scopes from X-OAuth-Scopes; [] for a fine-grained or GitHub App token, which does not list them."""
    return [s.strip() for s in (headers.get("x-oauth-scopes") or "").split(",") if s.strip()]


def scope_problem(scopes):
    """None when the token holds every scope in FULL_SCOPES, else what is missing and how to grant it."""
    if not scopes:
        return ("token không liệt kê scope (fine-grained hoặc GitHub App) — cần classic token tick mọi scope: %s, "
                "rồi nạp vào gh bằng gh auth login -h github.com --with-token" % CLASSIC_TOKEN_URL)
    missing = [s for s in FULL_SCOPES if s not in scopes]
    if not missing:
        return None
    return ("thiếu scope %s — gh auth refresh -h github.com -s %s (GitHub không cấp đủ qua gh thì tạo classic token tick "
            "mọi scope: %s, rồi gh auth login -h github.com --with-token)" % (", ".join(missing), ",".join(missing), CLASSIC_TOKEN_URL))


def http(method, path, body=None, want_headers=False):
    url = path if path.startswith("http") else API + path
    data = json.dumps(body).encode() if body is not None else None
    headers = {"Authorization": "Bearer " + token(), "Accept": "application/vnd.github+json",
               "X-GitHub-Api-Version": "2022-11-28"}
    if data is not None:
        headers["Content-Type"] = "application/json"
    for attempt in range(3):  # transient upstream errors must not end a long --wait or a doctor run
        status, res_headers, raw = afconfig.request(method, url, headers, data)
        if status not in RETRY_STATUS or attempt == 2:
            break
        time.sleep(min(int(res_headers.get("retry-after") or 0) or 2 ** (attempt + 1), 30))
    if status >= 400 or status == 0:
        raise RuntimeError("HTTP %s %s %s: %s" % (status, method, path, raw.decode(errors="replace")[:300]))
    payload = json.loads(raw) if raw else None
    return (payload, res_headers) if want_headers else payload


def gql(query, **variables):
    res = http("POST", "/graphql", {"query": query, "variables": variables})
    if res.get("errors"):
        raise RuntimeError("; ".join(e.get("message", "?") for e in res["errors"]))
    return res["data"]


def board_ref(url):
    ref = afconfig.parse_board_url(url)
    if not ref:
        die("board url không hợp lệ: %r" % url)
    ref["kind"] = "organization" if ref["owner_type"] == "org" else "user"
    return ref


FIELDS_Q = """
fields(first:50){ nodes{ __typename
  ... on ProjectV2FieldCommon{ id name dataType }
  ... on ProjectV2SingleSelectField{ options{ id name color description } } } }"""


def get_project(url):
    ref = board_ref(url)
    q = "query($l:String!,$n:Int!){ %s(login:$l){ projectV2(number:$n){ id title url shortDescription closed" \
        " items(first:1){ totalCount } repositories(first:20){ nodes{ nameWithOwner } }" \
        " views(first:20){ nodes{ id name layout filter } } %s } } }" % (ref["kind"], FIELDS_Q)
    proj = (gql(q, l=ref["owner"], n=ref["number"]).get(ref["kind"]) or {}).get("projectV2")
    if not proj:
        die("không resolve được board %s (sai URL, hoặc token thiếu scope project/admin:org — agentflow-board whoami)" % url, 4)
    proj["ref"] = ref
    return proj


def field(proj, name):
    for f in proj["fields"]["nodes"]:
        if f.get("name") == name:
            return f
    return None


def iter_items(url, field_names):
    ref = board_ref(url)
    fv = " ".join('f%d: fieldValueByName(name:%s){ ... on ProjectV2ItemFieldSingleSelectValue{ name } }'
                  % (i, json.dumps(n)) for i, n in enumerate(field_names))
    q = ("query($l:String!,$n:Int!,$a:String){ %s(login:$l){ projectV2(number:$n){ items(first:100, after:$a){"
         " pageInfo{ hasNextPage endCursor } nodes{ id type %s content{ __typename"
         " ... on Issue{ number title state closedAt repository{ nameWithOwner }"
         " labels(first:20){ nodes{ name } } assignees(first:5){ nodes{ login } } }"
         " ... on PullRequest{ number title state } ... on DraftIssue{ title } } } } } } }") % (ref["kind"], fv)
    after = None
    while True:
        page = gql(q, l=ref["owner"], n=ref["number"], a=after)[ref["kind"]]["projectV2"]["items"]
        for node in page["nodes"]:
            c = node.get("content") or {}
            yield {
                "item_id": node["id"], "type": node["type"], "number": c.get("number"), "title": c.get("title"),
                "state": c.get("state"), "closed_at": c.get("closedAt"),
                "repo": (c.get("repository") or {}).get("nameWithOwner"),
                "labels": [x["name"] for x in (c.get("labels") or {}).get("nodes", [])],
                "assignees": [x["login"] for x in (c.get("assignees") or {}).get("nodes", [])],
                "fields": {n: (node.get("f%d" % i) or {}).get("name") for i, n in enumerate(field_names)},
            }
        if not page["pageInfo"]["hasNextPage"]:
            return
        after = page["pageInfo"]["endCursor"]


# ── commands ──────────────────────────────────────────────────────────────────

def cmd_whoami(_):
    user, headers = http("GET", "/user", want_headers=True)
    scopes = token_scopes(headers)
    print("login: %s" % user["login"])
    print("scopes: %s" % (", ".join(scopes) or "(không liệt kê — fine-grained hoặc GitHub App token)"))
    problem = scope_problem(scopes)
    if problem:
        print("FAIL %s" % problem)
        sys.exit(1)
    print("OK token đủ full scope (%d scope của classic token)" % len(FULL_SCOPES))


def cmd_inspect(a):
    proj = get_project(a.url)
    status = field(proj, "Status") or {}
    counts, closed_not_done, drafts, done_total = {}, [], 0, 0
    done_name = a.done
    for it in iter_items(a.url, ["Status"]):
        st = it["fields"]["Status"]
        if a.repo and it["repo"] and it["repo"].lower() != a.repo.lower():
            continue
        if it["type"] == "DRAFT_ISSUE":
            drafts += 1
        elif st == done_name:
            done_total += 1
        elif it["state"] == "OPEN":
            counts[st or "(trống)"] = counts.get(st or "(trống)", 0) + 1
        elif it["number"]:
            closed_not_done.append(it["number"])
    out = {
        "id": proj["id"], "title": proj["title"], "url": proj["url"], "items": proj["items"]["totalCount"],
        "repos": [r["nameWithOwner"] for r in proj["repositories"]["nodes"]],
        "views": [{"name": v["name"], "layout": v["layout"], "filter": v["filter"]} for v in proj["views"]["nodes"]],
        "fields": {f["name"]: ([o["name"] for o in f["options"]] if "options" in f else f.get("dataType"))
                   for f in proj["fields"]["nodes"] if f.get("name")},
        "open_by_status": {o["name"]: counts.get(o["name"], 0) for o in status.get("options", []) if o["name"] != done_name},
        "done_total": done_total, "closed_not_done": closed_not_done, "drafts": drafts,
    }
    if counts.get("(trống)"):
        out["open_by_status"]["(trống)"] = counts["(trống)"]
    print(json.dumps(out, ensure_ascii=False))


def cmd_items(a):
    names = a.fields.split(",") if a.fields else ["Status"]
    for it in iter_items(a.url, names):
        if a.open and it["state"] != "OPEN":
            continue
        if a.repo and it["repo"] and it["repo"].lower() != a.repo.lower():
            continue
        vals = " ".join("%s=%s" % (k, json.dumps(v, ensure_ascii=False)) for k, v in it["fields"].items() if v)
        print("#%s %s %s %s labels=%s assignees=%s | %s" % (
            it["number"] or "-", it["type"], it["state"] or "-", vals, ",".join(it["labels"]) or "-",
            ",".join(it["assignees"]) or "-", (it["title"] or "")[:70]))


def plan_options(current, want, renames, drop_extra, color_for, desc_for, describe=False):
    by_name = {o["name"]: o for o in current}
    renamed = {}
    for spec in renames or []:
        old, _, new = spec.partition("=")
        if old not in by_name:
            die("--rename: không có option %r trên board" % old)
        renamed[new] = by_name[old]
    result, used = [], set()
    for idx, name in enumerate(want):
        src = by_name.get(name) or renamed.get(name)
        if src:
            used.add(src["id"])
            keep = src.get("description") if src["name"] == name and not describe else None
            result.append({"id": src["id"], "name": name, "color": src["color"], "description": keep or desc_for(idx, name)})
        else:
            result.append({"name": name, "color": color_for(idx, name), "description": desc_for(idx, name)})
    extra = [o for o in current if o["id"] not in used]
    if not drop_extra:
        result += [{"id": o["id"], "name": o["name"], "color": o["color"], "description": o.get("description") or ""} for o in extra]
    return result, extra


def _status_defaults(want):
    stages = afconfig.STAGES if len(want) == len(afconfig.STAGES) else None

    def color(i, _n):
        return STATUS_COLORS[stages[i]] if stages else "GRAY"

    def desc(i, _n):
        return STATUS_DESC[stages[i]] if stages else ""
    return color, desc


def _status_plan(a):
    proj = get_project(a.url)
    st = field(proj, "Status")
    if not st:
        die("board không có field Status")
    want = [w.strip() for w in a.want.split(",") if w.strip()]
    color, desc = _status_defaults(want)
    result, extra = plan_options(st["options"], want, a.rename, a.drop_extra, color, desc, a.describe)
    counts = {}
    for it in iter_items(a.url, ["Status"]):
        counts[it["fields"]["Status"]] = counts.get(it["fields"]["Status"], 0) + 1
    return proj, st, result, extra, counts


def cmd_status_plan(a, apply=False):
    proj, st, result, extra, counts = _status_plan(a)
    current = [o["name"] for o in st["options"]]
    print("hiện tại : %s" % " · ".join(current))
    print("sau apply: %s" % " · ".join(o["name"] for o in result))
    for o in result:
        if "id" not in o:
            print("  + thêm   %s" % o["name"])
        elif o["name"] not in current:
            old = next(x["name"] for x in st["options"] if x["id"] == o["id"])
            print("  ~ đổi tên %s → %s (giữ %d card)" % (old, o["name"], counts.get(old, 0)))
    lost = 0
    for o in extra:
        n = counts.get(o["name"], 0)
        if a.drop_extra:
            lost += n
            print("  - xoá    %s (%d card sẽ mất Status)" % (o["name"], n))
        else:
            print("  = giữ    %s (option ngoài mapping — card ở đây vô hình với agent)" % o["name"])
    if not apply:
        print("(dry-run — chạy status-apply ... --yes để ghi)")
        return
    if lost and not a.allow_drop:
        die("%d card sẽ mất Status — chuyển card đi trước, hoặc thêm --allow-drop" % lost)
    gql("mutation($f:ID!,$o:[ProjectV2SingleSelectFieldOptionInput!]){ updateProjectV2Field(input:{fieldId:$f,"
        " singleSelectOptions:$o}){ projectV2Field{ ... on ProjectV2SingleSelectField{ options{ name } } } } }",
        f=st["id"], o=result)
    after = [o["name"] for o in field(get_project(a.url), "Status")["options"]]
    print("OK Status: %s" % " · ".join(after))


def cmd_status_apply(a):
    if not a.yes:
        die("thiếu --yes (chạy status-plan trước để xem thay đổi)")
    cmd_status_plan(a, apply=True)


def _create_field(project_id, name, options):
    opts = [{"name": o, "color": "GRAY", "description": ""} for o in options]
    gql("mutation($p:ID!,$n:String!,$o:[ProjectV2SingleSelectFieldOptionInput!]){ createProjectV2Field(input:{"
        "projectId:$p, dataType:SINGLE_SELECT, name:$n, singleSelectOptions:$o}){ projectV2Field{ ... on"
        " ProjectV2SingleSelectField{ id } } } }", p=project_id, n=name, o=opts)


def cmd_ensure_field(a):
    proj = get_project(a.url)
    if field(proj, a.name):
        print("OK field %s đã có" % a.name)
        return
    _create_field(proj["id"], a.name, [x.strip() for x in a.options.split(",") if x.strip()])
    print("OK đã tạo field %s" % a.name)


def _platform_plan(a, labels):
    """(issue number → label, values without a label, values held by other repos' issues) for a board field."""
    mapping = {k.lower(): v for k, v in labels.items()}
    for spec in a.map or []:
        option, _, label = spec.partition("=")
        mapping[option.strip().lower()] = label.strip()
    plan, unmapped, foreign = {}, set(), set()
    for it in iter_items(a.url, [a.field]):
        value = it["fields"].get(a.field)
        if not value or not it["number"] or it["type"] != "ISSUE":
            continue
        if not it["repo"] or it["repo"].lower() != a.repo.lower():
            foreign.add(value)
        elif value.lower() in mapping:
            plan[it["number"]] = (mapping[value.lower()], it["labels"])
        else:
            unmapped.add(value)
    return plan, unmapped, foreign


def cmd_platform_migrate(a):
    root = afconfig.repo_root() or "."
    labels = afconfig.platform_labels(afconfig.load_config(root) or {})
    proj = get_project(a.url)
    fld = field(proj, a.field)
    if not fld:
        print("OK board không có field %s — không có gì để chuyển" % a.field)
        return
    plan, unmapped, foreign = _platform_plan(a, labels)
    for n, (label, have) in sorted(plan.items()):
        print("#%d %s%s" % (n, label, " (đã có)" if label in have else ""))
    if unmapped:
        die("giá trị chưa có label: %s — thêm vào labels.platform hoặc --map \"<giá trị>=<label>\"" % ", ".join(sorted(unmapped)))
    if not a.yes:
        print("PLAN %d issue — chạy lại với --yes để gắn label%s" % (len(plan), ", --drop-field để xoá field" if a.drop_field else ""))
        return
    for n, (label, have) in sorted(plan.items()):
        if label not in have:
            http("POST", "/repos/%s/issues/%d/labels" % (a.repo, n), {"labels": [label]})
    print("OK gắn label cho %d issue" % len(plan))
    if not a.drop_field:
        return
    if foreign:
        die("không xoá field %s: issue của repo khác trên board còn giá trị (%s)" % (a.field, ", ".join(sorted(foreign))))
    gql("mutation($f:ID!){ deleteProjectV2Field(input:{fieldId:$f}){ clientMutationId } }", f=fld["id"])
    print("OK đã xoá field %s" % a.field)


def cmd_create(a):
    kind = "organization" if a.owner_type == "org" else "user"
    owner_id = gql("query($l:String!){ %s(login:$l){ id } }" % kind, l=a.owner)[kind]["id"]
    repo_id = http("GET", "/repos/%s" % a.repo)["node_id"]
    proj = gql("mutation($o:ID!,$t:String!,$r:ID){ createProjectV2(input:{ownerId:$o, title:$t, repositoryId:$r}){"
               " projectV2{ id number url } } }", o=owner_id, t=a.title, r=repo_id)["createProjectV2"]["projectV2"]
    url = proj["url"]
    print("OK board %s" % url)
    a.url, a.rename, a.drop_extra, a.allow_drop, a.describe = url, [], True, True, True
    cmd_status_plan(a, apply=True)
    for spec in a.field or []:
        name, _, opts = spec.partition("=")
        try:
            _create_field(proj["id"], name, [x.strip() for x in opts.split(",") if x.strip()])
            print("OK field %s" % name)
        except RuntimeError as err:
            print("WARN field %s: %s" % (name, err))
    if a.sprint:
        start = dt.date.today() + dt.timedelta(days=(7 - dt.date.today().weekday()) % 7)
        try:
            gql("mutation($p:ID!,$c:ProjectV2IterationFieldConfigurationInput!){ createProjectV2Field(input:{projectId:$p,"
                " dataType:ITERATION, name:\"Sprint\", iterationConfiguration:$c}){ projectV2Field{ ... on"
                " ProjectV2IterationField{ id } } } }", p=proj["id"],
                c={"startDate": start.isoformat(), "duration": a.sprint, "iterations": []})
            print("OK field Sprint (%d ngày, bắt đầu %s)" % (a.sprint, start))
        except RuntimeError as err:
            print("WARN Sprint: %s — tạo tay trong Settings của board" % err)
    readme = open(a.readme, encoding="utf-8").read() if a.readme else None
    gql("mutation($p:ID!,$d:String,$r:String){ updateProjectV2(input:{projectId:$p, shortDescription:$d, readme:$r}){"
        " projectV2{ id } } }", p=proj["id"], d=a.description, r=readme)
    try:
        gql("mutation($p:ID!,$r:ID!){ linkProjectV2ToRepository(input:{projectId:$p, repositoryId:$r}){ repository{ id } } }",
            p=proj["id"], r=repo_id)
    except RuntimeError as err:
        if "already" not in str(err).lower():
            print("WARN link repo: %s" % err)
    view = get_project(url)["views"]["nodes"][0]
    try:
        gql("mutation($v:ID!){ updateProjectV2View(input:{viewId:$v, name:\"Board\", layout:BOARD_LAYOUT}){ projectV2View{ id } } }", v=view["id"])
        print("OK view Board")
    except RuntimeError as err:
        print("WARN view: %s" % err)
    print("URL %s" % url)


def cmd_labels(a):
    for spec in a.label:
        name, color, desc = (spec.split("|") + ["", ""])[:3]
        body = {"name": name, "color": color.lstrip("#") or "ededed", "description": desc[:100]}
        try:
            http("PATCH", "/repos/%s/labels/%s" % (a.repo, urllib.parse.quote(name, safe="")), {"color": body["color"], "description": body["description"]})
            print("= %s" % name)
        except RuntimeError as err:
            if "HTTP 404" not in str(err):
                raise
            http("POST", "/repos/%s/labels" % a.repo, body)
            print("+ %s" % name)


def cmd_issue_types(a):
    nodes = gql("query($l:String!){ organization(login:$l){ id issueTypes(first:25){ nodes{ id name isEnabled } } } }", l=a.org)["organization"]
    have = {n["name"]: n for n in nodes["issueTypes"]["nodes"]}
    for name, n in have.items():
        print("%s %s" % ("=" if n["isEnabled"] else "x", name))
    for spec in a.ensure or []:
        name, _, desc = spec.partition("|")
        if name in have:
            continue
        gql("mutation($o:ID!,$n:String!,$d:String){ createIssueType(input:{ownerId:$o, name:$n, description:$d, isEnabled:true}){ issueType{ id } } }",
            o=nodes["id"], n=name, d=desc)
        print("+ %s" % name)


def cmd_repo(a):
    r = http("GET", "/repos/%s" % a.slug)
    print(json.dumps({"full_name": r["full_name"], "owner_type": "org" if r["owner"]["type"] == "Organization" else "user",
                      "default_branch": r["default_branch"], "private": r["private"], "redirected": r["full_name"].lower() != a.slug.lower(),
                      "permissions": r.get("permissions")}, ensure_ascii=False))


def cmd_milestones(a):
    rows = []
    page = 1
    while True:
        batch = http("GET", "/repos/%s/milestones?state=open&per_page=100&page=%d" % (a.slug, page))
        rows += batch
        if len(batch) < 100:
            break
        page += 1
    if not rows:
        print("(không có milestone mở)")
        return
    rows.sort(key=lambda m: (m.get("due_on") is None, m.get("due_on") or "", m["number"]))
    for m in rows:
        due = (m.get("due_on") or "-")[:10]
        print("#%d %s due=%s open=%d" % (m["number"], m["title"], due, m.get("open_issues", 0)))


def _iso(ts):
    return dt.datetime.fromisoformat(ts.replace("Z", "+00:00"))


def _fmt_h(hours):
    return "%dd %dh" % (hours // 24, hours % 24) if hours >= 24 else "%.1fh" % hours


def cmd_metrics(a):
    stages = dict(kv.split("=", 1) for kv in (a.stages or "").split(",") if "=" in kv)
    ref = board_ref(a.url)
    since = dt.datetime.now(dt.timezone.utc) - dt.timedelta(days=a.days)
    q = ("query($l:String!,$n:Int!,$a:String){ %s(login:$l){ projectV2(number:$n){ items(first:25, after:$a){"
         " pageInfo{ hasNextPage endCursor } nodes{ st: fieldValueByName(name:\"Status\"){ ... on ProjectV2ItemFieldSingleSelectValue{ name } }"
         " content{ ... on Issue{ number state closedAt labels(first:20){ nodes{ name } }"
         " comments(last:60){ nodes{ createdAt body } } } } } } } } }") % ref["kind"]
    after, rows = None, []
    while True:
        page = gql(q, l=ref["owner"], n=ref["number"], a=after)[ref["kind"]]["projectV2"]["items"]
        for node in page["nodes"]:
            c = node.get("content") or {}
            if not c.get("number"):
                continue
            if c["state"] == "CLOSED" and (not c.get("closedAt") or _iso(c["closedAt"]) < since):
                continue
            events = []
            for cm in c["comments"]["nodes"]:
                head = (cm["body"] or "").lstrip().split("\n", 1)[0]
                if head.startswith("[AF:"):
                    events.append((_iso(cm["createdAt"]), head))
            rows.append({"n": c["number"], "state": c["state"], "closed": c.get("closedAt"), "status": (node.get("st") or {}).get("name"),
                         "labels": [x["name"] for x in c["labels"]["nodes"]], "events": events})
        if not page["pageInfo"]["hasNextPage"]:
            break
        after = page["pageInfo"]["endCursor"]
    now = dt.datetime.now(dt.timezone.utc)
    cycle, first_pr, passed, fpy, rev_fail, qc_fail, esc, info = [], [], 0, 0, 0, 0, 0, 0
    for r in rows:
        ev = r["events"]
        start = next((t for t, h in ev if h.startswith("[AF:DEV] start")), None)
        pr = next((t for t, h in ev if h.startswith("[AF:DEV] pr")), None)
        if start and pr:
            first_pr.append((pr - start).total_seconds() / 3600)
        if start and r["closed"]:
            cycle.append((_iso(r["closed"]) - start).total_seconds() / 3600)
        rf = sum(1 for _, h in ev if h.startswith(("[AF:SA] ❌", "[AF:REVIEW] ❌")))  # REVIEW: the SA before 3.0
        qf = sum(1 for _, h in ev if h.startswith("[AF:QC] ❌") or h.startswith("[AF:SYS] qc-failed"))
        rev_fail, qc_fail = rev_fail + rf, qc_fail + qf
        esc += any(h.startswith("[AF:SYS] escalated") for _, h in ev)
        info += any(h.startswith(("[AF:SA] ?", "[AF:DEV] ?", "[AF:QC] ?")) for _, h in ev)
        if any(h.startswith(("[AF:SA] ✅", "[AF:QC] ✅", "[AF:SYS] qc-manual-pass")) for _, h in ev):  # QC: the agent before 3.0
            passed += 1
            fpy += (rf + qf) == 0
    done = sum(1 for r in rows if r["closed"])
    agent_rows = [r for r in rows if r["events"]]
    print("BOARD %s   window %dd   tickets có [AF:] %d" % (a.url, a.days, len(agent_rows)))
    print("FLOW     done %d · cycle median %s · p90 %s · time-to-PR median %s" % (
        done, _fmt_h(statistics.median(cycle)) if cycle else "-",
        _fmt_h(sorted(cycle)[int(0.9 * (len(cycle) - 1))]) if cycle else "-",
        _fmt_h(statistics.median(first_pr)) if first_pr else "-"))
    print("QUALITY  first-pass yield %s (%d/%d) · review ❌ %d · QC ❌ %d · escalated %d · cần hỏi người %d" % (
        "%d%%" % (100 * fpy // passed) if passed else "-", fpy, passed, rev_fail, qc_fail, esc, info))
    waiting = set(filter(None, [stages.get("ready_to_merge")]))
    parked = tuple(x for x in (a.parked or "blocked,needs-info,qc-manual").split(",") if x)
    print("AGING (chờ người > 3 ngày)")
    for r in rows:
        if r["state"] != "OPEN" or not r["events"]:
            continue
        if r["status"] in waiting or set(r["labels"]) & set(parked):
            age = (now - r["events"][-1][0]).days
            if age > 3:
                print("  #%s %s %s %dd" % (r["n"], r["status"], ",".join(set(r["labels"]) & set(parked)) or "", age))


CHECK_OK = {"success", "neutral", "skipped"}
SETTLE_SECONDS = 120


def _head_checks(slug, branch, skip=(), skip_suites=()):
    """(head sha, state, failed names, registered) over check runs + commit statuses of the branch head. state: success | failure | pending;
    a head without any check yet is pending — the pipeline may not have registered. Checks named by a `skip` glob (a mobile
    release nobody waits for) count for neither; a head where only those ran is success."""
    sha = http("GET", "/repos/%s/commits/%s" % (slug, urllib.parse.quote(branch, safe="")))["sha"]
    runs, page = [], 1
    while True:
        batch = http("GET", "/repos/%s/commits/%s/check-runs?per_page=100&page=%d" % (slug, sha, page))["check_runs"]
        runs += batch
        if len(batch) < 100:
            break
        page += 1
    statuses = http("GET", "/repos/%s/commits/%s/status?per_page=100" % (slug, sha)).get("statuses") or []
    registered = bool(runs or statuses)
    runs = [r for r in runs if not _skipped(r["name"], skip) and (r.get("check_suite") or {}).get("id") not in skip_suites]
    statuses = [s for s in statuses if not _skipped(s["context"], skip)]
    failed = [{"name": r["name"], "url": r.get("html_url")} for r in runs if r["status"] == "completed" and r["conclusion"] not in CHECK_OK]
    failed += [{"name": s["context"], "url": s.get("target_url")} for s in statuses if s["state"] in ("failure", "error")]
    pending = any(r["status"] != "completed" for r in runs) or any(s["state"] == "pending" for s in statuses) or not registered
    return sha, "failure" if failed else "pending" if pending else "success", failed, registered


def _skipped(name, globs):
    return any(fnmatch.fnmatch(name or "", g) for g in globs)


def _contains(slug, deploy_sha, head):
    """A rewritten staging can leave deploy_sha unreachable: GitHub then answers 404 instead of a comparison."""
    try:
        return http("GET", "/repos/%s/compare/%s...%s" % (slug, deploy_sha, head))["status"] in ("ahead", "identical")
    except RuntimeError as err:
        if "HTTP 404" not in str(err):
            raise
        return False


def _too_fresh(since):
    """Green right after the push may only mean the pipeline has not registered all its checks yet."""
    return bool(since) and (dt.datetime.now(dt.timezone.utc) - _iso(since)).total_seconds() < SETTLE_SECONDS


RUN_WAITING = {"queued", "pending", "waiting", "requested"}


STALL_MINUTES = float(os.environ.get("AGENTFLOW_STALL_MINUTES") or 10)  # no run nor check on the head after this long: the dispatch went nowhere


def _head_runs(slug, branch, sha):
    try:
        return _branch_runs(slug, branch, sha)
    except RuntimeError:
        return None


def _qc_suites(slug, branch, sha):
    """Check suites of the QC builds dispatched here on this commit: DEV never waits for a build a person tests by hand."""
    try:
        return {r.get("check_suite_id") for r in _branch_runs(slug, branch, sha) if _run_kind(slug, r) == "qc"}
    except RuntimeError:
        return set()


def _config_skips(branch):
    """staging.skip_checks of a config written before 3.11, still honoured on the staging branch."""
    cfg = afconfig.load_config(afconfig.repo_root() or ".") or {}
    return afconfig.as_list((cfg.get("staging") or {}).get("skip_checks")) if branch == afconfig.staging_branch(cfg) else []


def cmd_checks(a):
    deadline = time.time() + a.wait * 60
    skip = list(a.skip or ()) + _config_skips(a.branch)
    while True:
        head = http("GET", "/repos/%s/commits/%s" % (a.slug, urllib.parse.quote(a.branch, safe="")))["sha"]
        sha, state, failed, registered = _head_checks(a.slug, a.branch, skip, _qc_suites(a.slug, a.branch, head))
        if state == "success" and _too_fresh(a.since):
            state = "pending"
        contains = _contains(a.slug, a.contains, sha) if a.contains else True
        if state != "pending" or not contains or time.time() >= deadline:
            break
        time.sleep(30)
    out = {"state": state, "sha": sha, "contains": contains, "failed": failed}
    if state == "pending":
        runs = _head_runs(a.slug, a.branch, sha)
        if runs and any(r.get("status") in RUN_WAITING for r in runs):
            out["queued"] = True  # waits for its concurrency group, e.g. behind a QC build of the apps
        late = a.since and (dt.datetime.now(dt.timezone.utc) - _iso(a.since)).total_seconds() > STALL_MINUTES * 60
        if runs is not None and not runs and not registered and late:
            out["stalled"] = True  # nothing started: the dispatch went nowhere. A started run ends by its jobs' timeout-minutes
    print(json.dumps(out, ensure_ascii=False))


MAX_RERUNS = 2  # re-runs per workflow run: run_attempt 1 is the push itself
RUN_FAILED = {"failure", "cancelled", "timed_out", "startup_failure"}
RUN_ACTIVE = {"queued", "in_progress", "waiting", "requested", "pending"}


def _origin_slug(root):
    remote = afconfig.git(["config", "--get", "remote.origin.url"], cwd=root) or afconfig.git(["remote", "get-url", "origin"], cwd=root) or ""  # before insteadOf
    return remote.rstrip("/").removesuffix(".git").replace("git@github.com:", "").split("github.com/")[-1]


def _staging_scope(a):
    """(config, staging branch) of the repo the command runs in. The workflow commands act on this branch only, and only for
    the repo of `origin`: the agent passes the slug, the config decides what it may touch."""
    root = afconfig.repo_root() or "."
    cfg = afconfig.load_config(root)
    if cfg is None:
        die("không có agentflow.yaml ở %s" % root)
    branch = afconfig.staging_branch(cfg)
    if not branch:
        die("staging.branch chưa khai báo")
    origin = _origin_slug(root)
    if origin.lower() != a.slug.lower() and http("GET", "/repos/%s" % a.slug)["full_name"].lower() != origin.lower():
        die("%s không phải repo của origin (%s)" % (a.slug, origin))
    return cfg, branch


def _staging_head(slug, branch):
    return http("GET", "/repos/%s/commits/%s" % (slug, urllib.parse.quote(branch, safe="")))["sha"]


def _branch_runs(slug, branch, head_sha=None):
    query = "branch=%s&per_page=100" % urllib.parse.quote(branch, safe="")
    if head_sha:
        query += "&head_sha=" + head_sha
    return http("GET", "/repos/%s/actions/runs?%s" % (slug, query)).get("workflow_runs") or []


def _picked_runs(a, branch, default):
    """The run named by --run, which must belong to the staging branch, else the default list."""
    if not a.run:
        return default()
    run = http("GET", "/repos/%s/actions/runs/%d" % (a.slug, a.run))
    if run.get("head_branch") != branch:
        die("run %d chạy trên %r, không phải nhánh staging %r — agent chỉ đụng run của staging" % (a.run, run.get("head_branch"), branch))
    return [run]


def _input_value(value):
    if isinstance(value, bool):
        return "true" if value else "false"
    return "" if value is None else str(value)


E2E_TMP = os.environ.get("AGENTFLOW_E2E_TMP") or "/tmp"  # where agentflow-e2e keeps its runs
# A run the agent dispatched, by kind: how long another ticket's push may not cancel it. deploy: superseded by the next
# deploy at once. wipe: dropping it would drop the wipe silently. qc: the build a person is waiting for to test by hand.
KEEP_SECONDS = {"deploy": 0, "wipe": 3600, "qc": 3 * 3600}
MARK_WINDOW = (-60, 180)  # seconds between a dispatch and the run GitHub creates for it
MARK_TTL = 24 * 3600


def _marks_file(slug):
    return os.path.join(E2E_TMP, "af-dispatch-%s.json" % re.sub(r"[^\w.-]+", "_", slug.lower()))


def _marks(slug):
    try:
        with open(_marks_file(slug), encoding="utf-8") as fh:
            marks = json.load(fh)
        return [m for m in marks if (dt.datetime.now(dt.timezone.utc) - _iso(m["at"])).total_seconds() < MARK_TTL]
    except (OSError, ValueError, KeyError, TypeError):
        return []


def _mark(slug, workflow, kind, at, issue=None, on=()):
    marks = _marks(slug) + [{"workflow": workflow, "kind": kind, "at": at, "issue": issue, "on": list(on)}]
    with open(_marks_file(slug), "w", encoding="utf-8") as fh:
        json.dump(marks, fh)


def _run_mark(slug, run):
    """The dispatch of this machine that created the run (None = a person, a push, another machine). A run matching several
    dispatches takes the one kept longest."""
    if run.get("event") != "workflow_dispatch" or not run.get("created_at"):
        return None
    marks = [m for m in _marks(slug) if (run.get("path") or "").endswith("/" + m["workflow"])
             and MARK_WINDOW[0] <= (_iso(run["created_at"]) - _iso(m["at"])).total_seconds() <= MARK_WINDOW[1]]
    return max(marks, key=lambda m: KEEP_SECONDS.get(m["kind"], 0)) if marks else None


def _run_kind(slug, run):
    mark = _run_mark(slug, run)
    return mark["kind"] if mark else None


def _kept(slug, run):
    """Why the run must outlive a newer push, or None."""
    kind = _run_kind(slug, run)
    if kind and KEEP_SECONDS.get(kind) and (dt.datetime.now(dt.timezone.utc) - _iso(run["created_at"])).total_seconds() < KEEP_SECONDS[kind]:
        return {"wipe": "run có wipe dữ liệu", "qc": "bản build cho QC người"}[kind]
    return None


def _running_flows(issue):
    """Other issues with an unfinished agentflow-e2e run on this machine: their flows use staging data right now."""
    busy = set()
    for path in glob.glob(os.path.join(E2E_TMP, "af-*-e2e", "*", "state.json")):
        try:
            with open(path, encoding="utf-8") as fh:
                state = json.load(fh)
            if state.get("done") or str(state.get("issue")) == str(issue) or not state.get("pid"):
                continue
            os.kill(int(state["pid"]), 0)
        except (OSError, ValueError, TypeError):
            continue
        busy.add(int(state["issue"]))
    return sorted(busy)


def _staging_users(cfg, slug, issue):
    """Who would lose data to a wipe: other open tickets of the repo in In QC (a person tests on staging) and other
    tickets running flows on this machine. → list of {issue, why}."""
    users = [{"issue": n, "why": "đang chạy flow"} for n in _running_flows(issue)]
    board = (cfg.get("board") or {}).get("url")
    in_qc = ((cfg.get("board") or {}).get("status") or {}).get("in_qc")
    if board and in_qc:
        for it in iter_items(board, ["Status"]):
            other = it["number"] != issue and it["number"] not in [u["issue"] for u in users]
            same_repo = (it["repo"] or "").lower() == slug.lower()
            testing = it["state"] == "OPEN" and it["fields"].get("Status") == in_qc
            if other and same_repo and testing:
                users.append({"issue": it["number"], "why": "In QC — người đang test tay"})
    return users


def _qc_release(slug, issue):
    """Inputs DEV marked in the ticket's state block (`qc_release`) as needed for a person's QC build."""
    owner, name = slug.split("/", 1)
    node = (gql("query($o:String!,$r:String!,$n:Int!){ repository(owner:$o,name:$r){ issue(number:$n){ body } } }",
                o=owner, r=name, n=issue).get("repository") or {}).get("issue")
    if not node:
        die("không thấy issue #%d trong %s" % (issue, slug))
    value = _state_block(node["body"]).get("qc_release") or ""
    return [p.strip() for p in re.split(r"[,\s]+", value) if p.strip() and p.strip() not in ("—", "-")]


def _workflow_inputs(slug, branch, wf):
    inputs = afconfig.dispatch_inputs(_workflow_text(slug, wf["file"], branch))
    if inputs is None:
        die("%s không có trên %s hoặc không có trigger workflow_dispatch" % (wf["file"], branch))
    return inputs


def _pick_workflow(cfg, file, on, slug, branch):
    """(entry, its inputs): the named workflow, else the one declared workflow, else the first that has every input of `on`."""
    declared = afconfig.staging_workflows(cfg)
    if not declared:
        die("staging.workflows trống — người khai workflow agent được chạy trên staging")
    if file:
        hits = [w for w in declared if w["file"] == file]
        if not hits:
            die("%s không nằm trong staging.workflows (%s) — người khai trong agentflow.yaml" % (file, ", ".join(w["file"] for w in declared)))
        return hits[0], _workflow_inputs(slug, branch, hits[0])
    for wf in declared:
        inputs = _workflow_inputs(slug, branch, wf)
        if len(declared) == 1 or set(on) <= set(inputs):
            return wf, inputs
    die("không workflow nào trong staging.workflows có đủ ô %s — thêm --workflow" % ", ".join(on))


def _supersede(slug, branch, head, workflow, on):
    """Cancel the unfinished deploys of `workflow` on older staging commits that this machine dispatched and that turned on
    nothing the new run leaves off: the new run deploys a head that contains theirs. Runs of people, QC builds, wipes and
    runs that built something this one does not are left alone."""
    done = []
    for run in _branch_runs(slug, branch):
        if run.get("status") not in RUN_ACTIVE or run.get("head_sha") == head or not (run.get("path") or "").endswith("/" + workflow):
            continue
        mark = _run_mark(slug, run)
        if mark and mark["kind"] == "deploy" and set(mark.get("on") or []) <= set(on):
            http("POST", "/repos/%s/actions/runs/%d/cancel" % (slug, run["id"]), {})
            done.append({"run": run["id"], "sha": (run.get("head_sha") or "")[:7]})
    return done


COMPARE_FILES_MAX = 300  # GitHub lists at most this many files of a comparison


def _deployed(slug, branch, head, cfg, workflow):
    """Head of the last deploy by `workflow` when the staging `head` brings nothing a release must build since, else None.
    Only the newest run of the workflow counts, QC builds dispatched here aside (they leave the stack as it was and run
    long): a newer run still going, failed, cancelled or of another branch leaves what staging runs unknown."""
    try:
        runs = http("GET", "/repos/%s/actions/workflows/%s/runs?per_page=20" % (slug, urllib.parse.quote(workflow, safe="")))
        last = next((r for r in runs.get("workflow_runs") or [] if _run_kind(slug, r) != "qc"), None)
        if not last or last.get("head_branch") != branch or (last.get("status"), last.get("conclusion")) != ("completed", "success"):
            return None
        if last.get("head_sha") == head:
            return head
        diff = http("GET", "/repos/%s/compare/%s...%s" % (slug, last["head_sha"], head))
    except (RuntimeError, KeyError):
        return None
    files = diff.get("files") or []
    if diff.get("status") not in ("ahead", "identical") or len(files) >= COMPARE_FILES_MAX:
        return None
    paths = [p for f in files for p in (f.get("filename"), f.get("previous_filename")) if p]
    return None if afconfig.release_paths(cfg, paths) else last["head_sha"]


def cmd_workflows(a):
    """The boolean inputs ("ô") of each declared staging workflow, with what each one does: what the agent picks from."""
    cfg, branch = _staging_scope(a)
    for wf in afconfig.staging_workflows(cfg):
        inputs = _workflow_inputs(a.slug, branch, wf)
        boxes = [{"name": n, "description": i["description"], "default": i["default"], **({"wipe": True} if i["wipe"] else {})}
                 for n, i in inputs.items() if i["type"] == "boolean" and n not in wf["inputs"]]
        print(json.dumps({"workflow": wf["file"], "inputs": boxes, "fixed": sorted(set(wf["inputs"]))}, ensure_ascii=False))


def cmd_dispatch(a):
    cfg, branch = _staging_scope(a)
    on = [p.strip() for p in (a.on or "").split(",") if p.strip()]
    if a.qc and not a.issue:
        die("--qc cần --issue <n> (ticket sang In QC)")
    if a.qc and not on:
        on = _qc_release(a.slug, a.issue)
        if not on:
            print(json.dumps({"dispatched": [], "why": "state qc_release trống — QC tay không cần bản cài mới"}, ensure_ascii=False))
            return
    wf, inputs = _pick_workflow(cfg, a.workflow, on, a.slug, branch)
    boxes = {n: i for n, i in inputs.items() if i["type"] == "boolean" and n not in wf["inputs"]}
    unknown = [n for n in on if n not in boxes]
    if unknown:
        die("%s không phải ô (input boolean) agent bật được của %s — có: %s" % (", ".join(unknown), wf["file"], ", ".join(boxes) or "không ô nào"))
    wipe = [n for n in on if boxes[n]["wipe"]]
    if wipe and a.qc:
        die("bản build cho QC không wipe — người đang test trên staging")
    if wipe and not a.issue:
        die("bật %s (xoá dữ liệu staging) cần --issue <n> (ticket đang deploy)" % ", ".join(wipe))
    if wipe:
        users = _staging_users(cfg, a.slug, a.issue)
        if users:
            print(json.dumps({"refused": "wipe", "busy": users}, ensure_ascii=False))
            sys.exit(5)
    head = _staging_head(a.slug, branch)
    out = {"dispatched": [], "ref": branch, "sha": head}
    deployed = None if a.qc or on or a.force else _deployed(a.slug, branch, head, cfg, wf["file"])
    if deployed:
        out.update(deployed=deployed, why="bản deploy @%s đã có mọi thay đổi phải build — flow chạy luôn, không chờ" % deployed[:7])
        print(json.dumps(out, ensure_ascii=False))
        return
    if not a.qc:
        try:
            cancelled = _supersede(a.slug, branch, head, wf["file"], on)
            if cancelled:
                out["cancelled"] = cancelled
        except RuntimeError as err:  # superseding saves runner time; the release itself must still go out
            out["cancel_error"] = str(err)[:200]
    body_inputs = {str(k): _input_value(v) for k, v in wf["inputs"].items()}
    body_inputs.update({n: "true" if n in on else "false" for n in boxes})
    body = {"ref": branch, "inputs": body_inputs} if body_inputs else {"ref": branch}
    http("POST", "/repos/%s/actions/workflows/%s/dispatches" % (a.slug, urllib.parse.quote(wf["file"], safe="")), body)
    at = dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    _mark(a.slug, wf["file"], "qc" if a.qc else "wipe" if wipe else "deploy", at, a.issue, sorted(on))
    out.update(dispatched=[{"workflow": wf["file"], "on": sorted(on)}], at=at)
    if wipe:
        out["wipe"] = True
    print(json.dumps(out, ensure_ascii=False))


def cmd_rerun(a):
    _, branch = _staging_scope(a)
    runs = _picked_runs(a, branch, lambda: _branch_runs(a.slug, branch, _staging_head(a.slug, branch)))
    done, skipped = [], []
    for run in runs:
        row = {"run": run["id"], "name": run.get("name"), "attempt": run.get("run_attempt") or 1}
        if run.get("status") != "completed" or run.get("conclusion") not in RUN_FAILED:
            continue
        if row["attempt"] > MAX_RERUNS:
            skipped.append(dict(row, why="đã rerun %d lần" % MAX_RERUNS))
            continue
        http("POST", "/repos/%s/actions/runs/%d/rerun-failed-jobs" % (a.slug, run["id"]), {})
        done.append(row)
    print(json.dumps({"rerun": done, "skipped": skipped}, ensure_ascii=False))


def cmd_cancel(a):
    """Unfinished runs on older staging commits that a newer one supersedes: those a push started (CI on push) and the
    deploys dispatched here. `--run` names any run of the staging branch; a wipe or a QC build is kept either way."""
    _, branch = _staging_scope(a)
    head = _staging_head(a.slug, branch)
    runs = _picked_runs(a, branch, lambda: _branch_runs(a.slug, branch))
    done, kept = [], []
    for run in runs:
        if run.get("status") not in RUN_ACTIVE or run.get("head_sha") == head:
            continue
        row = {"run": run["id"], "name": run.get("name"), "sha": (run.get("head_sha") or "")[:7]}
        why = _kept(a.slug, run)
        if why:
            kept.append(dict(row, why=why))
            continue
        if not a.run and run.get("event") != "push" and _run_kind(a.slug, run) != "deploy":
            continue
        http("POST", "/repos/%s/actions/runs/%d/cancel" % (a.slug, run["id"]), {})
        done.append(row)
    out = {"cancelled": done, "head": head}
    if kept:
        out["kept"] = kept
    print(json.dumps(out, ensure_ascii=False))


TRUSTED = ("OWNER", "MEMBER", "COLLABORATOR")
STATE_BLOCK = re.compile(r"<!--\s*agentflow:state\s*\n(.*?)-->", re.S)
BODY_MAX = 1500
PR_FIELDS = "number state isDraft headRefName url repository{ nameWithOwner } headRepository{ nameWithOwner }"
ISSUE_PRS_Q = ("query($o:String!,$r:String!,$n:Int!){ repository(owner:$o,name:$r){ issue(number:$n){ body"
               " closedByPullRequestsReferences(first:10, includeClosedPrs:false){ nodes{ %s } }"
               " timelineItems(itemTypes:[CROSS_REFERENCED_EVENT], last:50){ nodes{ ... on CrossReferencedEvent{"
               " source{ ... on PullRequest{ %s } } } } } } } }") % (PR_FIELDS, PR_FIELDS)
COMMENT_FIELDS = "databaseId author{ login } authorAssociation body createdAt"
PR_FEEDBACK_Q = ("query($o:String!,$r:String!,$m:Int!){ repository(owner:$o,name:$r){ pullRequest(number:$m){ %s"
                 " reviewThreads(first:100){ nodes{ isResolved isOutdated path line originalLine"
                 " root: comments(first:1){ nodes{ databaseId } } comments(last:30){ nodes{ %s } } } }"
                 " reviews(last:50){ nodes{ databaseId author{ login } authorAssociation state body submittedAt } }"
                 " comments(last:100){ nodes{ %s } } } } }") % (PR_FIELDS, COMMENT_FIELDS, COMMENT_FIELDS)


def _state_block(body):
    match = STATE_BLOCK.search(body or "")
    pairs = (line.partition(":") for line in (match.group(1) if match else "").splitlines())
    return {key.strip(): value.strip() for key, sep, value in pairs if sep}


def _from_people(node):
    """Feedback of a person: trusted author, and not one of the agent's own [AF:…] comments (same login as the user)."""
    return node.get("authorAssociation") in TRUSTED and not (node.get("body") or "").lstrip().startswith("[AF:")


def _entry(node, at_key="createdAt", **extra):
    body = (node.get("body") or "").strip()
    entry = dict(extra, author=(node.get("author") or {}).get("login"), at=node.get(at_key))
    entry["body"] = body if len(body) <= BODY_MAX else body[:BODY_MAX] + "…"
    return entry


def _newer(ts, since):
    return bool(ts) and (not since or _iso(ts) > _iso(since))


def _linked_prs(slug, issue):
    """Open PRs of this repo (not from a fork) that close or mention the issue."""
    found = {}
    sources = [n.get("source") or {} for n in issue["timelineItems"]["nodes"]]
    for pr in issue["closedByPullRequestsReferences"]["nodes"] + sources:
        same_repo = all(((pr.get(k) or {}).get("nameWithOwner") or "").lower() == slug.lower() for k in ("repository", "headRepository"))
        if pr.get("number") and pr.get("state") == "OPEN" and same_repo:
            found[pr["number"]] = pr
    return [found[n] for n in sorted(found)]


def _pr_feedback(pr, since):
    """pending: what sends the ticket back to DEV — open threads whose last word is a person's, Request changes after
    `since`. notes: review bodies and PR comments after `since`, read with them but never a trigger on their own."""
    pending, notes = [], []
    for thread in pr["reviewThreads"]["nodes"]:
        said = [c for c in thread["comments"]["nodes"] if c.get("authorAssociation") in TRUSTED]
        if thread["isResolved"] or not said or not _from_people(said[-1]):
            continue
        pending.append({"kind": "thread", "reply_to": thread["root"]["nodes"][0]["databaseId"], "path": thread["path"],
                        "line": thread["line"] or thread["originalLine"], "outdated": thread["isOutdated"],
                        "comments": [_entry(c) for c in said]})
    for review in pr["reviews"]["nodes"]:
        if not _from_people(review) or not _newer(review.get("submittedAt"), since):
            continue
        if review["state"] == "CHANGES_REQUESTED":
            pending.append(_entry(review, "submittedAt", kind="changes_requested"))
        elif review["state"] == "COMMENTED" and (review.get("body") or "").strip():
            notes.append(_entry(review, "submittedAt", kind="review"))
    for comment in pr["comments"]["nodes"]:
        if _from_people(comment) and _newer(comment.get("createdAt"), since):
            notes.append(_entry(comment, kind="comment"))
    return pending, notes


def _feedback(slug, number):
    owner, name = slug.split("/", 1)
    issue = (gql(ISSUE_PRS_Q, o=owner, r=name, n=number).get("repository") or {}).get("issue")
    if not issue:
        raise RuntimeError("không thấy issue #%d trong %s" % (number, slug))
    state = _state_block(issue["body"])
    linked = _linked_prs(slug, issue)
    res = {"issue": number, "pr": None, "pending": [], "notes": [], "fb": state.get("fb") or None}
    pr_number = int(state["pr"].lstrip("#")) if state.get("pr", "").lstrip("#").isdigit() else None
    if pr_number is None and len(linked) == 1:
        pr_number = linked[0]["number"]
    elif pr_number is None and linked:
        res["prs"] = [{"number": p["number"], "branch": p["headRefName"], "url": p["url"]} for p in linked]
    if pr_number is None:
        return res
    pr = gql(PR_FEEDBACK_Q, o=owner, r=name, m=pr_number)["repository"]["pullRequest"]
    res.update(pr=pr["number"], branch=pr["headRefName"], state=pr["state"], draft=pr["isDraft"], url=pr["url"])
    if pr["state"] != "OPEN":
        return res
    res["pending"], res["notes"] = _pr_feedback(pr, res["fb"])
    read = [e["at"] for e in res["pending"] + res["notes"] if e.get("at")] + ([res["fb"]] if res["fb"] else [])
    res["fb"] = max(read, key=_iso) if read else None  # DEV writes it back to the state block once handled
    return res


def cmd_feedback(a):
    failed = False
    for number in a.issue:
        try:
            res = _feedback(a.slug, number)
        except RuntimeError as err:
            failed = True
            print(json.dumps({"issue": number, "error": str(err)[:300]}, ensure_ascii=False))
            continue
        if a.summary:
            res = dict({k: res[k] for k in ("issue", "pr", "prs") if k in res}, pending=len(res["pending"]))
        print(json.dumps(res, ensure_ascii=False))
    if failed:
        sys.exit(2)


ITEM_STATUS = ("projectItems(first:20){ nodes{ id project{ id number owner{ ... on Organization{ login } ... on User{ login } } }"
               " status: fieldValueByName(name:\"Status\"){ ... on ProjectV2ItemFieldSingleSelectValue{ name } } } }")
GROUP_F = ("fragment G on Issue{ id number state body labels(first:30){ nodes{ name } } subIssues(first:50){ nodes{ number state } }"
           " %s parent{ number state body labels(first:30){ nodes{ name } } %s } }") % (ITEM_STATUS, ITEM_STATUS)
ACTIVE_STAGES = ("ready", "in_progress", "in_review", "in_qc", "ready_to_merge")  # a parent here runs as one ticket


def _numbers(value):
    return [int(x) for x in re.findall(r"\d+", value or "")]


def _issues(slug, numbers):
    """{number: issue node of GROUP_F} in one query."""
    owner, name = slug.split("/", 1)
    fields = " ".join("i%d: issue(number:%d){ ...G }" % (n, n) for n in numbers)
    repo = gql("query($o:String!,$r:String!){ repository(owner:$o,name:$r){ %s } } %s" % (fields, GROUP_F), o=owner, r=name)["repository"] or {}
    return {n: repo.get("i%d" % n) for n in numbers}


def _board_item(node, ref):
    """(item id, Status name) of the issue on the board of agentflow.yaml, or (None, None)."""
    for item in ((node or {}).get("projectItems") or {}).get("nodes") or []:
        project = item.get("project") or {}
        if project.get("number") == ref["number"] and ((project.get("owner") or {}).get("login") or "").lower() == ref["owner"].lower():
            return item["id"], (item.get("status") or {}).get("name")
    return None, None


def _group_row(cfg, ref, number, node):
    """subs: open sub-issues · group: sub-issues the ticket works on together (state block, set by SA design) · in_group:
    the parent whose one PR carries this issue — a parent at Ready or later, which listed it or, not designed yet, while
    the issue is not the agent's own."""
    if not node:
        return {"issue": number, "error": "không thấy issue"}
    state = _state_block(node["body"])
    row = {"issue": number, "subs": [x["number"] for x in node["subIssues"]["nodes"] if x["state"] == "OPEN"],
           "group": _numbers(state.get("group")), "in_group": None}
    parent = node.get("parent")
    if not parent or parent["state"] != "OPEN":
        return row
    status = cfg.get("board", {}).get("status") or {}
    active = _board_item(parent, ref)[1] in [status.get(k) for k in ACTIVE_STAGES if status.get(k)]
    pstate = _state_block(parent["body"])
    agent = (cfg.get("labels") or {}).get("agent")
    listed = number in _numbers(pstate.get("group")) if "group" in pstate else agent not in [x["name"] for x in node["labels"]["nodes"]]
    if active and listed:
        row["in_group"] = parent["number"]
    return row


def _group_cfg():
    cfg = afconfig.load_config(afconfig.repo_root() or ".")
    if not cfg or not (cfg.get("board") or {}).get("url"):
        die("agentflow.yaml thiếu board.url")
    return cfg, board_ref(cfg["board"]["url"])


def cmd_group(a):
    cfg, ref = _group_cfg()
    for number, node in _issues(a.slug, a.issue).items():
        print(json.dumps(_group_row(cfg, ref, number, node), ensure_ascii=False))


PR_SECTIONS = ("Lệch thiết kế", "Test tự động", "Kiểm chứng lại", "QC tay")  # dev.md §6: always in the PR body
TC_ROW = re.compile(r"^\s*\|.*?\bTC[-\s]?(\d+)\b(.*)$", re.M)
AUTO_LEVEL = re.compile(r"\b(e2e|api)\b", re.I)


def _rest_pages(path):
    """Every page of a REST list (per_page=100)."""
    out, page = [], 1
    while True:
        chunk = http("GET", "%s%sper_page=100&page=%d" % (path, "&" if "?" in path else "?", page)) or []
        out.extend(chunk)
        if len(chunk) < 100:
            return out
        page += 1


def _design_tcs(comments):
    """TC numbers of level e2e/api in the latest trusted `[AF:SA] design` comment (its test case table)."""
    designs = [c for c in comments if (c.get("author_association") in TRUSTED
                                       and (c.get("body") or "").lstrip().startswith("[AF:SA] design"))]
    if not designs:
        return None
    return sorted({int(n) for n, rest in TC_ROW.findall(designs[-1]["body"]) if AUTO_LEVEL.search(rest)})


def _template_headings(slug, base):
    try:
        res = http("GET", "/repos/%s/contents/.github/pull_request_template.md?ref=%s" % (slug, urllib.parse.quote(base)))
    except RuntimeError:
        return []  # no template in this repo
    text = base64.b64decode(res.get("content") or "").decode("utf-8", "replace")
    return [m.strip() for m in re.findall(r"^#{1,6}\s+(.+?)\s*#*$", text, re.M)]


def precheck(slug, number, pr_number, cfg):
    """What would send the PR back before any review: the PR body against dev.md §6 and the design, conflicts."""
    issue = http("GET", "/repos/%s/issues/%d" % (slug, number))
    state = _state_block(issue.get("body"))
    pr_number = pr_number or (int(state["pr"].lstrip("#")) if state.get("pr", "").lstrip("#").isdigit() else None)
    res = {"issue": number, "pr": pr_number, "problems": []}
    if not pr_number:
        res["problems"].append("chưa có PR: truyền --pr <m>")
        return res
    pr = http("GET", "/repos/%s/pulls/%d" % (slug, pr_number))
    if pr.get("mergeable") is None and pr.get("state") == "open":  # GitHub computes it on the first read
        time.sleep(3)
        pr = http("GET", "/repos/%s/pulls/%d" % (slug, pr_number))
    res["head"] = (pr.get("head") or {}).get("sha")
    body, problems = pr.get("body") or "", res["problems"]
    base = afconfig.base_branch(cfg)
    link = str((cfg.get("git") or {}).get("link") or "Closes")
    if pr.get("state") != "open":
        problems.append("PR #%d không mở" % pr_number)
    if not pr.get("draft"):
        problems.append("PR phải là draft")
    if (pr.get("base") or {}).get("ref") != base:
        problems.append("base của PR phải là %s" % base)
    if pr.get("mergeable_state") == "dirty":
        problems.append("conflict với %s: git merge origin/%s (không rebase commit đã push)" % (base, base))
    for n in [number] + _numbers(state.get("group")):
        if not re.search(r"\b%s\s+#%d\b" % (re.escape(link), n), body, re.I):
            problems.append("body thiếu `%s #%d`" % (link, n))
    if not re.search(r"^\s*[-*] \[[ xX]\] ", body, re.M):
        problems.append("body thiếu checklist AC (`- [ ]`)")
    missing = [s for s in PR_SECTIONS + tuple(_template_headings(slug, base)) if s.lower() not in body.lower()]
    problems.extend("body thiếu mục \"%s\"" % s for s in dict.fromkeys(missing))
    tcs = _design_tcs(_rest_pages("/repos/%s/issues/%d/comments" % (slug, number)))
    if tcs is None:
        problems.append("issue chưa có `[AF:SA] design`")
        return res
    named = {int(n) for n in re.findall(r"\bTC[-\s]?(\d+)\b", body)}
    absent = [t for t in tcs if t not in named]
    if absent:
        problems.append("bảng AC / Test tự động thiếu TC %s của thiết kế" % ", ".join("TC%d" % t for t in absent))
    if tcs and "đỏ trước" not in body.lower():
        problems.append("Test tự động thiếu dòng \"Đỏ trước\" (flow mới fail trên bản chưa có thay đổi, hoặc bỏ qua — lý do)")
    return res


def cmd_precheck(a):
    cfg = afconfig.load_config(afconfig.repo_root() or ".") or {}
    try:
        res = precheck(a.slug, a.issue, a.pr, cfg)
    except RuntimeError as err:
        print(json.dumps({"issue": a.issue, "error": str(err)[:300]}, ensure_ascii=False))
        sys.exit(2)
    res["ok"] = not res["problems"]
    print(json.dumps(res, ensure_ascii=False))
    sys.exit(0 if res["ok"] else 1)


def cmd_group_sync(a):
    """Sub-issues of a group follow the Status of their parent, so the board shows where each one is."""
    cfg, ref = _group_cfg()
    parent = _issues(a.slug, [a.issue])[a.issue]
    if not parent:
        die("không thấy issue #%d trong %s" % (a.issue, a.slug))
    subs = _numbers(_state_block(parent["body"]).get("group"))
    if not subs:
        print(json.dumps({"issue": a.issue, "synced": []}))
        return
    status = _board_item(parent, ref)[1]
    if not status:
        die("#%d chưa có Status trên board" % a.issue)
    proj = get_project(cfg["board"]["url"])
    fld = field(proj, "Status")
    option = next((o["id"] for o in fld["options"] if o["name"] == status), None)
    synced, added = [], []
    for number, node in _issues(a.slug, subs).items():
        if not node:
            continue
        item, current = _board_item(node, ref)
        if current == status:
            continue
        if not item:
            item = gql("mutation($p:ID!,$c:ID!){ addProjectV2ItemById(input:{projectId:$p, contentId:$c}){ item{ id } } }",
                       p=proj["id"], c=node["id"])["addProjectV2ItemById"]["item"]["id"]
            added.append(number)
        gql("mutation($p:ID!,$i:ID!,$f:ID!,$o:String!){ updateProjectV2ItemFieldValue(input:{projectId:$p, itemId:$i, fieldId:$f,"
            " value:{singleSelectOptionId:$o}}){ projectV2Item{ id } } }", p=proj["id"], i=item, f=fld["id"], o=option)
        synced.append(number)
    out = {"issue": a.issue, "status": status, "synced": synced}
    if added:
        out["added"] = added
    print(json.dumps(out, ensure_ascii=False))


def _branch_rules(slug, branch):
    try:
        return {r.get("type") for r in http("GET", "/repos/%s/rules/branches/%s" % (slug, urllib.parse.quote(branch, safe="")))}
    except RuntimeError:
        return set()


def _doctor_staging(slug, branch, ok, warn):
    sha, state, _, _ = _head_checks(slug, branch)
    runs = http("GET", "/repos/%s/commits/%s/check-runs?per_page=1" % (slug, sha)).get("total_count")
    statuses = http("GET", "/repos/%s/commits/%s/status" % (slug, sha)).get("total_count")
    if runs or statuses:
        ok("pipeline staging báo check về commit (head đang %s)" % state)
    else:
        warn("head staging không có check nào — chưa có pipeline thì DEV dispatch xong không có gì để chờ và blocked")
    rules = _branch_rules(slug, branch) & {"pull_request", "required_status_checks", "update"}
    if rules:
        warn("ruleset trên %s (%s) có thể chặn SA push trực tiếp" % (branch, ", ".join(sorted(rules))))


def _workflow_text(slug, name, branch):
    path = "/repos/%s/contents/.github/workflows/%s?ref=%s" % (slug, urllib.parse.quote(name, safe=""), urllib.parse.quote(branch, safe=""))
    try:
        return base64.b64decode(http("GET", path).get("content") or "").decode(errors="replace")
    except RuntimeError:
        return None


def _yaml_list(lines, key):
    """Items of `key:` written inline ([a, b] or a scalar) or as `- a` lines below it; None when the key is absent."""
    for i, line in enumerate(lines):
        m = re.match(r"^(\s*)%s\s*:\s*(.*?)\s*(#.*)?$" % re.escape(key), line)
        if not m:
            continue
        if m.group(2):
            return [x.strip().strip("'\"") for x in m.group(2).strip("[]").split(",") if x.strip()]
        items = []
        for below in lines[i + 1:]:
            item = re.match(r"^\s*-\s*(.+?)\s*(#.*)?$", below)
            if not item:
                break
            items.append(item.group(1).strip("'\""))
        return items
    return None


def _runs_on_push(text, branch):
    """Whether a push to `branch` starts the workflow: a top-level `on` with push, not tag-only, whose branch filters
    let it through. A heuristic over the YAML text, enough for doctor."""
    lines = (text or "").splitlines()
    start = next((i for i, l in enumerate(lines) if re.match(r"^[\"']?on[\"']?\s*:", l)), None)
    if start is None:
        return False
    inline = re.sub(r"#.*", "", lines[start].split(":", 1)[1]).strip()
    if inline:
        return bool(re.search(r"\bpush\b", inline))
    block = []
    for line in lines[start + 1:]:
        if line.strip() and not line[:1].isspace():
            break
        block.append(line)
    if any(re.match(r"^\s+-\s*push\s*$", l) for l in block):
        return True
    at = next((i for i, l in enumerate(block) if re.match(r"^\s+push\s*:", l)), None)
    if at is None:
        return False
    indent = len(block[at]) - len(block[at].lstrip())
    sub = []
    for line in block[at + 1:]:
        if line.strip() and len(line) - len(line.lstrip()) <= indent:
            break
        sub.append(line)
    branches, ignore = _yaml_list(sub, "branches"), _yaml_list(sub, "branches-ignore")
    if branches is None and ignore is None:
        return _yaml_list(sub, "tags") is None and _yaml_list(sub, "tags-ignore") is None
    if branches is not None:
        return any(fnmatch.fnmatch(branch, b) for b in branches)
    return not any(fnmatch.fnmatch(branch, b) for b in ignore)


def _doctor_workflows(slug, branch, workflows, ok, fail):
    """Each declared workflow must exist on the staging branch and accept workflow_dispatch, or DEV's dispatch fails."""
    for wf in workflows:
        inputs = afconfig.dispatch_inputs(_workflow_text(slug, wf["file"], branch))
        if inputs is None:
            fail("staging.workflows: %s không có trên %s hoặc không có trigger workflow_dispatch — agent không chạy được" % (wf["file"], branch))
            continue
        boxes = ["%s%s" % (n, " (xoá dữ liệu)" if i["wipe"] else "") for n, i in inputs.items() if i["type"] == "boolean" and n not in wf["inputs"]]
        ok("workflow %s dispatch được trên %s — ô agent chọn: %s" % (wf["file"], branch, ", ".join(boxes) or "không có"))


def _doctor_push(slug, branch, cfg, ok, warn):
    """Staging runs its pipelines only by dispatch: which workflows still start on a push to it, and whether the [skip ci]
    of DEV's merge commit still does anything."""
    try:
        listing = http("GET", "/repos/%s/contents/.github/workflows?ref=%s" % (slug, urllib.parse.quote(branch, safe="")))
    except RuntimeError:
        return
    names = [f["name"] for f in listing if isinstance(f, dict) and str(f.get("name")).endswith((".yml", ".yaml"))] if isinstance(listing, list) else []
    on_push = [n for n in names if _runs_on_push(_workflow_text(slug, n, branch), branch)]
    if on_push and afconfig.staging_skip_ci(cfg):
        warn("%s còn chạy khi push %s (DEV gắn [skip ci] nên chưa chạy hai lần) — bỏ trigger push để staging chỉ chạy qua dispatch" % (", ".join(on_push), branch))
    elif on_push:
        ok("pipeline staging chạy khi push (%s)" % ", ".join(on_push))
    else:
        ok("staging chỉ chạy workflow qua dispatch")


def _doctor_base(slug, base, ok, warn):
    protected = bool(_branch_rules(slug, base))
    if not protected:
        try:
            protected = bool(http("GET", "/repos/%s/branches/%s" % (slug, urllib.parse.quote(base, safe=""))).get("protected"))
        except RuntimeError:
            pass
    if protected:
        ok("%s có branch protection" % base)
    else:
        warn("%s không có branch protection — guard là lớp chặn duy nhất, mà guard chỉ là best-effort. Nên bật nếu gói GitHub cho phép" % base)


def _maestro():
    """Where the maestro CLI is: on PATH, or only where its installer puts it (then agents' shells may not find it)."""
    found = shutil.which("maestro")
    if found:
        return found, True
    home = os.path.expanduser("~/.maestro/bin/maestro")
    return (home, False) if os.access(home, os.X_OK) else (None, False)


def _uses_maestro(cfg):
    surfaces = cfg.get("surfaces") if isinstance(cfg.get("surfaces"), dict) else {}
    return any("maestro" in str(s.get("e2e") or "") or str(s.get("e2e_dir") or "").rstrip("/").endswith(".maestro")
               for s in surfaces.values() if isinstance(s, dict))


CREDENTIALS_IN_URL = re.compile(r"(://)[^/@\s]+@")


def _push_probe(root, base):
    """Dry-run push of the base onto itself: needs the push endpoint and push credentials, writes nothing.
    A network that lets fetch through but blocks push (git-receive-pack) only shows up here."""
    if not base:
        return False, "không xác định được base branch"
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0")
    env.setdefault("GIT_SSH_COMMAND", "ssh -o BatchMode=yes -o ConnectTimeout=15")
    ref = "refs/remotes/origin/%s" % base
    try:
        subprocess.run(["git", "fetch", "-q", "origin", base], cwd=root, env=env, capture_output=True, timeout=60)
        res = subprocess.run(["git", "push", "--dry-run", "--porcelain", "origin", "%s:refs/heads/%s" % (ref, base)],
                             cwd=root, env=env, capture_output=True, text=True, timeout=60)
    except subprocess.TimeoutExpired:
        return False, "git push --dry-run quá 60 giây — mạng chặn hoặc treo endpoint push"
    except OSError as err:
        return False, "không chạy được git (%s)" % err
    if res.returncode == 0 or "\n!" in "\n" + res.stdout:
        return True, ""
    lines = [l.strip() for l in (res.stderr or res.stdout).splitlines() if l.strip()]
    return False, CREDENTIALS_IN_URL.sub(r"\1", lines[-1] if lines else "exit %d" % res.returncode)[:240]


def _needed_env(cfg):
    notify = cfg.get("notify") or {}
    return ["TELEGRAM_BOT_TOKEN", "TELEGRAM_CHAT_ID"] if notify.get("telegram") else []


def cmd_preflight(a):
    root = a.root or afconfig.repo_root() or "."
    try:
        cfg = afconfig.load_config(root) or {}
    except ValueError:
        cfg = {}
    pushed, why = _push_probe(root, afconfig.base_branch(cfg))
    local_env = afconfig.settings_env(root)
    out = {"push": pushed, "missing_env": [n for n in _needed_env(cfg) if not local_env.get(n)]}
    if not pushed:
        out["push_error"] = why
    print(json.dumps(out, ensure_ascii=False))


def cmd_doctor(a):
    root = a.root or afconfig.repo_root() or "."
    ok = lambda m: print("✓ " + m)  # noqa: E731
    warn = lambda m: print("⚠ " + m)  # noqa: E731
    bad = []

    def fail(m):
        bad.append(m)
        print("✗ " + m)
    try:
        cfg = afconfig.load_config(root)
    except ValueError as err:
        fail("agentflow.yaml không parse được: %s" % err)
        sys.exit(1)
    if cfg is None:
        fail("không có agentflow.yaml ở %s — chạy /agentflow:init" % root)
        sys.exit(1)
    (ok if cfg.get("schema") == afconfig.SCHEMA else fail)("schema %s (plugin đọc %d)" % (cfg.get("schema"), afconfig.SCHEMA))
    for level, msg in afconfig.validate_config(cfg):
        if not msg.startswith(("board.status.", "staging.branch")):  # the checks below report these with board context
            (fail if level == "fail" else warn)(msg)
    if _uses_maestro(cfg):
        path, on_path = _maestro()
        if on_path:
            ok("maestro: %s" % path)
        else:
            warn("maestro %s — DEV không chạy được flow Maestro, test case UI thành checklist QC tay" % (
                "có ở %s nhưng không nằm trong PATH: thêm ~/.maestro/bin vào PATH" % path if path else "chưa cài: curl -fsSL https://get.maestro.mobile.dev | bash"))
    if os.path.isfile(os.path.join(root, ".mcp.json")):
        try:
            with open(os.path.join(root, ".mcp.json"), encoding="utf-8") as fh:
                dup = "api.githubcopilot.com/mcp" in fh.read()
        except OSError:
            dup = False
        if dup:
            warn(".mcp.json của repo khai GitHub MCP trùng URL với plugin — server của plugin bị loại trùng, tool mất tiền tố mcp__plugin_agentflow_github__ và subagent không gọi được. Bỏ server đó khỏi .mcp.json")
    ignored = subprocess.run(["git", "check-ignore", "-q", ".claude/settings.local.json"], cwd=root).returncode == 0
    tracked = subprocess.run(["git", "ls-files", "--error-unmatch", ".claude/settings.local.json"], cwd=root, capture_output=True).returncode == 0
    (ok if ignored and not tracked else fail)(".claude/settings.local.json gitignored%s" % (" nhưng đang bị TRACK" if tracked else ""))
    local_env = afconfig.settings_env(root)
    need = _needed_env(cfg)
    missing = [n for n in need if not local_env.get(n)]
    if need:
        (fail if missing else ok)("env của .claude/settings.local.json: %s" % (
            "thiếu " + ", ".join(missing) + " — agentflow-settings set-secret <TÊN>" if missing else ", ".join(need)))
    gaps = afconfig.missing_allow(root)
    if gaps:
        warn("permissions.allow thiếu %s — agent và subagent sẽ dừng hỏi quyền (Claude Code bỏ qua defaultMode bypassPermissions "
             "trong settings của project): agentflow-settings allow --user %s (mọi repo; bỏ --user = chỉ repo này)" % (", ".join(gaps), " ".join(gaps)))
    else:
        ok("permissions.allow đủ cho agent")
    stale = [n for n in afconfig.GITHUB_TOKEN_ENV if local_env.get(n)]
    if stale:
        warn("env.%s trong .claude/settings.local.json: plugin dùng token của gh, nhưng Claude Code đưa biến này vào session nên gh "
             "và MCP dùng nó thay tài khoản gh — xoá: agentflow-settings unset %s" % (", env.".join(stale), " ".join(stale)))
    src = next((n for n in afconfig.GITHUB_TOKEN_ENV if os.environ.get(n)), None)
    if src:
        warn("token lấy từ $%s, không phải tài khoản đăng nhập của gh" % src)
    try:
        user, headers = http("GET", "/user", want_headers=True)
    except (RuntimeError, SystemExit) as err:
        fail("token không dùng được: %s" % err)
        sys.exit(1)
    scopes = token_scopes(headers)
    ok("login %s" % user["login"])
    board = cfg.get("board") or {}
    ref = afconfig.parse_board_url(board.get("url"))
    if not ref:
        fail("board.url không hợp lệ: %r" % board.get("url"))
        sys.exit(1)
    problem = scope_problem(scopes)
    if problem:
        fail(problem)
    else:
        ok("token đủ full scope (%d scope của classic token)" % len(FULL_SCOPES))
    if scopes and "project" not in scopes:  # every board query below fails without it, each with a long GraphQL error
        print("KẾT QUẢ: %d lỗi — dừng trước khi đọc board" % len(bad))
        sys.exit(1)
    proj = get_project(board["url"])
    ok("board %s (%d item)" % (proj["title"], proj["items"]["totalCount"]))
    st = field(proj, "Status") or {"options": []}
    names = [o["name"] for o in st["options"]]
    mapping = board.get("status") or {}
    for stage in afconfig.STAGES:
        name = mapping.get(stage)
        if not name:
            fail("board.status.%s chưa map" % stage)
        elif name not in names:
            fail("board.status.%s = %r không có trên board (có: %s)" % (stage, name, " · ".join(names)))
    unmapped = [n for n in names if n not in mapping.values()]
    if unmapped:
        warn("option Status ngoài mapping: %s — card ở đó agent không thấy" % ", ".join(unmapped))
    elif all(mapping.get(s) in names for s in afconfig.STAGES):
        ok("Status map đủ 7 stage")
    for key, fname in (board.get("fields") or {}).items():
        if key != "platform":  # 3.7: a label now; validate_config says how to migrate
            (ok if field(proj, fname) else fail)("field %s = %r" % (key, fname))
    try:
        wf = gql("query($i:ID!){ node(id:$i){ ... on ProjectV2{ workflows(first:20){ nodes{ name enabled } } } } }", i=proj["id"])
        flows = {w["name"]: w["enabled"] for w in wf["node"]["workflows"]["nodes"]}
        (ok if flows.get("Item closed") else warn)("workflow \"Item closed\" %s" % ("bật" if flows.get("Item closed") else "CHƯA bật — merge xong card không tự sang done (Board → ⋯ → Workflows)"))
    except RuntimeError:
        pass
    slug = _origin_slug(root)
    if slug.count("/") == 1:
        canonical = http("GET", "/repos/%s" % slug)["full_name"]
        if canonical.lower() != slug.lower():
            warn("remote trỏ %s, canonical là %s" % (slug, canonical))
        repos = [r["nameWithOwner"] for r in proj["repositories"]["nodes"]]
        (ok if canonical in repos else warn)("board %slink với %s" % ("" if canonical in repos else "chưa ", canonical))
        labels = afconfig.label_names(cfg)
        have, page = set(), 1
        while True:
            batch = http("GET", "/repos/%s/labels?per_page=100&page=%d" % (canonical, page))
            have |= {x["name"] for x in batch}
            if len(batch) < 100:
                break
            page += 1
        miss = [x for x in labels if x not in have]
        (fail if miss else ok)("labels%s" % (" thiếu: " + ", ".join(miss) if miss else " đủ"))
        base = afconfig.base_branch(cfg)
        if afconfig.git(["ls-remote", "--exit-code", "--heads", "origin", base], cwd=root, timeout=20) is not None:
            ok("base branch %s · protected %s" % (base, sorted(afconfig.protected_branches(cfg, root))))
            pushed, why = _push_probe(root, base)
            (ok if pushed else fail)("push lên origin%s" % ("" if pushed else " không được: %s — agent không mở PR, deploy hay commit test được" % why))
        else:
            fail("base branch %r không có trên origin — việc mới tạo từ origin/<git.base>: khai `git.base` (vd main)" % base)
        stag = afconfig.staging_branch(cfg)
        if not stag:
            fail("staging.branch chưa khai báo — bắt buộc")
        elif stag == base:
            fail("staging.branch = %r trùng base — staging chỉ để build test, PR phải nhắm nhánh khác" % stag)
        elif afconfig.git(["ls-remote", "--exit-code", "--heads", "origin", stag], cwd=root, timeout=20) is None:
            fail("staging.branch %r không có trên origin" % stag)
        else:
            ok("staging branch %s" % stag)
            _doctor_staging(canonical, stag, ok, warn)
            _doctor_workflows(canonical, stag, afconfig.staging_workflows(cfg), ok, fail)
            _doctor_push(canonical, stag, cfg, ok, warn)
        if base:
            _doctor_base(canonical, base, ok, warn)
        if not (cfg.get("staging") or {}).get("url"):
            warn("staging.url trống — DEV không chạy được flow API/web trên staging, các test case đó thành checklist QC tay")
        repo_owner_is_org = http("GET", "/repos/%s" % canonical)["owner"]["type"] == "Organization"
        if cfg.get("classify") == "issue-type" and not repo_owner_is_org:
            fail("classify: issue-type nhưng repo thuộc user — issue type chỉ có ở org; đổi sang classify: label")
        elif cfg.get("classify") == "issue-type":
            types = {n["name"] for n in gql("query($l:String!){ organization(login:$l){ issueTypes(first:25){ nodes{ name } } } }", l=canonical.split("/")[0])["organization"]["issueTypes"]["nodes"]}
            miss = [t for t in (cfg.get("types") or {}) if t not in types]
            (fail if miss else ok)("issue types%s" % (" thiếu: " + ", ".join(miss) if miss else " đủ"))
    for key, s in (cfg.get("surfaces") or {}).items():
        s = s or {}
        path = os.path.join(root, s.get("path") or "")
        if not os.path.isdir(path):
            fail("surface %s: path %r không tồn tại" % (key, s.get("path")))
        elif not s.get("check"):
            warn("surface %s chưa có lệnh check — DEV phải tự tìm (tốn token)" % key)
        else:
            ok("surface %s (%s)" % (key, s.get("path")))
    print("KẾT QUẢ: %s" % ("OK" if not bad else "%d lỗi" % len(bad)))
    sys.exit(1 if bad else 0)


def main():
    p = argparse.ArgumentParser(prog="agentflow-board", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("whoami")
    s = sub.add_parser("inspect"); s.add_argument("url"); s.add_argument("--done", default="Done"); s.add_argument("--repo", help="board dùng chung: chỉ đếm repo này")
    s = sub.add_parser("items"); s.add_argument("url"); s.add_argument("--open", action="store_true"); s.add_argument("--fields"); s.add_argument("--repo")
    for name in ("status-plan", "status-apply"):
        s = sub.add_parser(name); s.add_argument("url"); s.add_argument("--want", required=True)
        s.add_argument("--rename", action="append"); s.add_argument("--drop-extra", action="store_true")
        s.add_argument("--allow-drop", action="store_true"); s.add_argument("--yes", action="store_true")
        s.add_argument("--describe", action="store_true", help="ghi đè description bằng mô tả của plugin")
    s = sub.add_parser("ensure-field"); s.add_argument("url"); s.add_argument("--name", required=True); s.add_argument("--options", required=True)
    s = sub.add_parser("platform-migrate"); s.add_argument("url"); s.add_argument("--repo", required=True)
    s.add_argument("--field", default="Platform"); s.add_argument("--map", action="append", help="Option=label, lặp được")
    s.add_argument("--yes", action="store_true"); s.add_argument("--drop-field", action="store_true")
    s = sub.add_parser("create")
    for flag in ("--owner", "--title", "--repo", "--want"):
        s.add_argument(flag, required=True)
    s.add_argument("--owner-type", choices=["org", "user"], required=True)
    s.add_argument("--field", action="append"); s.add_argument("--sprint", type=int)
    s.add_argument("--description"); s.add_argument("--readme")
    s = sub.add_parser("repo"); s.add_argument("slug")
    s = sub.add_parser("milestones"); s.add_argument("slug")
    s = sub.add_parser("labels"); s.add_argument("--repo", required=True); s.add_argument("--label", action="append", required=True)
    s = sub.add_parser("issue-types"); s.add_argument("--org", required=True); s.add_argument("--ensure", action="append")
    s = sub.add_parser("metrics"); s.add_argument("url"); s.add_argument("--days", type=int, default=30); s.add_argument("--stages")
    s.add_argument("--parked", help="tên label chờ người, phân tách bằng dấu phẩy")
    s = sub.add_parser("checks"); s.add_argument("slug"); s.add_argument("--branch", required=True)
    s.add_argument("--contains", help="deploy_sha phải nằm trong head; bỏ trống = chỉ đọc check của head (vd base đỏ sẵn chưa)")
    s.add_argument("--wait", type=float, default=0, help="số phút chờ thêm khi còn pending")
    s.add_argument("--since", help="deploy_at: check xanh trong 2 phút đầu vẫn tính là pending")
    s.add_argument("--skip", action="append", help="glob tên check không chờ (staging.skip_checks, vd release mobile); lặp được")
    s = sub.add_parser("workflows"); s.add_argument("slug")
    s = sub.add_parser("dispatch"); s.add_argument("slug"); s.add_argument("--workflow", help="tên file trong staging.workflows (một file thì bỏ)")
    s.add_argument("--on", help="ô (input boolean) cần bật, vd backend,web — ô boolean còn lại gửi false")
    s.add_argument("--qc", action="store_true", help="bản build cho QC người (orchestrator, ticket sang In QC): --on mặc định = state qc_release")
    s.add_argument("--issue", type=int, help="ticket đang deploy (bắt buộc khi bật ô xoá dữ liệu, và với --qc)")
    s.add_argument("--force", action="store_true", help="chạy cả khi bản deploy cuối đã có mọi thay đổi phải build")
    for name in ("rerun", "cancel"):
        s = sub.add_parser(name); s.add_argument("slug"); s.add_argument("--run", type=int, help="id run trên nhánh staging")
    s = sub.add_parser("group"); s.add_argument("slug"); s.add_argument("--issue", type=int, action="append", required=True)
    s = sub.add_parser("group-sync"); s.add_argument("slug"); s.add_argument("--issue", type=int, required=True)
    s = sub.add_parser("feedback"); s.add_argument("slug"); s.add_argument("--issue", type=int, action="append", required=True)
    s.add_argument("--summary", action="store_true", help="một dòng mỗi issue: pr + số mục chờ DEV")
    s = sub.add_parser("precheck"); s.add_argument("slug"); s.add_argument("--issue", type=int, required=True)
    s.add_argument("--pr", type=int, help="PR của ticket (mặc định state block `pr`)")
    s = sub.add_parser("doctor"); s.add_argument("--root")
    s = sub.add_parser("preflight"); s.add_argument("--root")
    a = p.parse_args()
    handler = {"whoami": cmd_whoami, "inspect": cmd_inspect, "items": cmd_items, "status-plan": cmd_status_plan,
               "status-apply": cmd_status_apply, "ensure-field": cmd_ensure_field, "create": cmd_create,
               "platform-migrate": cmd_platform_migrate, "workflows": cmd_workflows, "dispatch": cmd_dispatch, "rerun": cmd_rerun, "cancel": cmd_cancel,
               "labels": cmd_labels, "repo": cmd_repo, "milestones": cmd_milestones, "issue-types": cmd_issue_types, "metrics": cmd_metrics, "checks": cmd_checks,
               "feedback": cmd_feedback, "precheck": cmd_precheck, "group": cmd_group, "group-sync": cmd_group_sync, "doctor": cmd_doctor, "preflight": cmd_preflight}[a.cmd]
    try:
        handler(a)
    except RuntimeError as err:
        die(str(err), 2)


if __name__ == "__main__":
    main()
