           "flag_hardcoded", "hex", "rgb", "color_literal", "default_palette", "arbitrary_value", "font_family", "off_grid", "emoji",
           "hardcoded_text", "no_loading", "no_empty", "no_error")


def image_size(path):
    """(width, height) of a PNG, GIF, WebP or JPEG from its header; None for anything else."""
    try:
        with open(path, "rb") as fh:
            head = fh.read(64 * 1024)
    except OSError:
        return None
    try:
        if head[:8] == b"\x89PNG\r\n\x1a\n":
            return struct.unpack(">II", head[16:24])
        if head[:6] in (b"GIF87a", b"GIF89a"):
            return struct.unpack("<HH", head[6:10])
        if head[:4] == b"RIFF" and head[8:12] == b"WEBP":
            chunk = head[12:16]
            if chunk == b"VP8X":
                return 1 + int.from_bytes(head[24:27], "little"), 1 + int.from_bytes(head[27:30], "little")
            if chunk == b"VP8 ":
                w, h = struct.unpack("<HH", head[26:30])
                return w & 0x3FFF, h & 0x3FFF
            if chunk == b"VP8L":
                bits = int.from_bytes(head[21:25], "little")
                return (bits & 0x3FFF) + 1, ((bits >> 14) & 0x3FFF) + 1
        if head[:2] == b"\xff\xd8":
            i = 2
            while i + 9 < len(head):
                if head[i] != 0xFF:
                    i += 1
                    continue
                marker = head[i + 1]
                if marker in (0xD8, 0x01, 0xFF) or 0xD0 <= marker <= 0xD7:
                    i += 1 if marker == 0xFF else 2
                    continue
                if marker in (0xC0, 0xC1, 0xC2, 0xC3, 0xC5, 0xC6, 0xC7, 0xC9, 0xCA, 0xCB, 0xCD, 0xCE, 0xCF):
                    h, w = struct.unpack(">HH", head[i + 5:i + 9])
                    return w, h
                i += 2 + struct.unpack(">H", head[i + 2:i + 4])[0]
    except struct.error:
        return None
    return None


def in_comment(text, pos):
    start = text.rfind("\n", 0, pos) + 1
    stripped = text[start:pos].lstrip()
    return stripped.startswith(("//", "/*", "*", "<!--", "{/*"))


def ui_file(rel, lang, text):
    ext = os.path.splitext(rel)[1].lower()
    if ext in UI_EXT:
        return True
    if lang == "dart":
        return bool(re.search(r"\bWidget\s+build\(|extends\s+(?:StatelessWidget|StatefulWidget|State<|ConsumerWidget|HookWidget)", text))
    if lang == "kotlin":
        return "@Composable" in text or "setContentView" in text
    if lang == "swift":
        return bool(re.search(r":\s*View\s*\{|some View|UIViewController|: UIView\b", text))
    if lang in JS_LIKE:
        in_ui = bool(set(rel.lower().split("/")[:-1]) & UI)
        return in_ui and bool(re.search(r"<[A-Z]\w*|StyleSheet\.create|createElement", text))
    return False


class Signals:
    """Hits of named patterns: count, files, first places; per file for the areas."""

    def __init__(self):
        self.data, self.per_file = {}, collections.defaultdict(collections.Counter)
        self.first, self.seen = collections.defaultdict(dict), set()

    def add(self, name, rel, text=None, pos=0, line=None):
        line = line if line is not None else (line_of(text, pos) if text is not None else 0)
        if (name, rel, line) in self.seen:  # one hit a line: `Lorem ipsum dolor sit amet` is one placeholder
            return
        self.seen.add((name, rel, line))
        entry = self.data.setdefault(name, {"count": 0, "files": collections.Counter(), "at": []})
        entry["count"] += 1
        entry["files"][rel] += 1
        where = "%s:%d" % (rel, line) if line else rel
        if len(entry["at"]) < 5:
            entry["at"].append(where)
        self.per_file[rel][name] += 1
        self.first[rel].setdefault(name, where)

    def report(self, names, n):
        return {k: {"count": self.data[k]["count"], "files": len(self.data[k]["files"]), "top": top(self.data[k]["files"], min(n, 5)),
                    "at": self.data[k]["at"]} for k in names if k in self.data}


def nearest(rel, marker, dirs):
    """Folder of the closest ancestor of `rel` that holds `marker` (a file or folder name), '' = repo root, None = none."""
    parts = rel.split("/")[:-1]
    for i in range(len(parts), -1, -1):
        base = "/".join(parts[:i])
        if ((base + "/") if base else "") + marker in dirs:
            return base
    return None


def ancestors(listing):
    """Every tracked file and every folder above one: what `nearest` probes."""
    out = set(listing)
    for rel in listing:
        parts = rel.split("/")
        for i in range(1, len(parts)):
            out.add("/".join(parts[:i]))
    return out


def resolve_import(rel, spec, known):
    if spec.startswith(("@/", "~/")):
        parts = rel.split("/")
        base = "/".join(parts[:parts.index("src") + 1]) if "src" in parts else os.path.dirname(rel)
        cand = base + "/" + spec[2:]
    elif spec.startswith("package:"):
        parts = rel.split("/")
        base = "/".join(parts[:parts.index("lib") + 1]) if "lib" in parts else ""
        cand = base + "/" + (spec.split("/", 1)[1] if "/" in spec else "")
    else:
        cand = os.path.normpath(os.path.join(os.path.dirname(rel), spec)).replace("\\", "/")
    for suffix in ("", ".tsx", ".ts", ".jsx", ".js", ".vue", ".svelte", "/index.tsx", "/index.ts", "/index.jsx", "/index.js"):
        if cand + suffix in known:
            return cand + suffix
    return None


def asset_names(rel):
    """Names code would use for an asset: stem without @2x, an imageset's name, flutter_gen's camelCase."""
    stem = os.path.splitext(os.path.basename(rel))[0]
    m = AT_SCALE.match(stem)
    stem = m.group(1) if m else stem
    imageset = re.search(r"([^/]+)\.imageset/", rel)
    names = {imageset.group(1)} if imageset else {stem}
    for name in list(names):
        camel = re.sub(r"[-_ ]+(\w)", lambda c: c.group(1).upper(), name)
        names.add(camel)
    return names


IDENTITY_PATH = re.compile(r"(^|/)(mipmap-[^/]+|AppIcon[^/]*\.appiconset|LaunchImage[^/]*|Splash[^/]*|splash[^/]*|launch[^/]*)/"
                           r"|(^|/)(favicon|apple-touch-icon|apple-icon|icon-\d+|Icon-\d+|logo\d+|opengraph-image|og-image|twitter-image|"
                           r"android-chrome-[^/]*|mstile-[^/]*|icon|adaptive-icon|splash(?:-icon)?)\.\w+$|(^|/)fonts?/", re.I)


def asset_exists(root, known, cand):
    """React Native resolves `a.png` to `a@2x.png` and `a@3x.png` too."""
    stem, ext = os.path.splitext(cand)
    variants = (cand, stem + "@2x" + ext, stem + "@3x" + ext)
    return any(v in known or os.path.exists(os.path.join(root, v)) for v in variants)


def assets_report(root, listing, blob, sources, n):
    images = [p for p in listing if p.lower().endswith(IMAGE_EXT) and not TESTS.search(p)]
    known = set(listing)
    dirs = ancestors(listing)
    out = {"images": len(images), "raster": 0, "svg": 0, "bytes": 0}
    heavy, icons = [], []
    for rel in images:
        path = os.path.join(root, rel)
        try:
            size = os.path.getsize(path)
        except OSError:
            continue
        out["bytes"] += size
        if rel.lower().endswith(".svg"):
            out["svg"] += 1
            if size > HEAVY_SVG:
                heavy.append({"path": rel, "kb": size // 1024})
            continue
        out["raster"] += 1
        dims = image_size(path)
        if size > HEAVY_RASTER:
            heavy.append({"path": rel, "kb": size // 1024, "px": "%dx%d" % dims if dims else None})
        low = rel.lower()
        iconish = re.search(r"(^|/)(icons?|ic)(/|_)|/ic_[^/]+$", low) and not IDENTITY_PATH.search(rel)
        if iconish and dims and max(dims) <= ICON_PX:
            icons.append(rel)
    out["heavy"] = sorted(heavy, key=lambda h: -h["kb"])[:n]
    out["raster_icons"] = {"count": len(icons), "at": icons[:5]}
    gaps = []
    groups = collections.defaultdict(set)  # (dir, stem, ext) → @1x/@2x/@3x seen
    flutter = collections.defaultdict(set)
    android = collections.defaultdict(set)
    android_used = collections.defaultdict(set)
    for rel in images + [p for p in listing if ANDROID_RES.search(p)]:
        res = ANDROID_RES.search(rel)
        if res:
            kind, quals, name = res.group(1), (res.group(2) or "").split("-"), res.group(3)
            dens = [q for q in quals if q in DENSITIES]
            if dens and res.group(4) != "xml":
                night = "night" in quals
                android[(rel.split("/res/")[0], kind, night, name)].add(dens[0])
                android_used[(rel.split("/res/")[0], kind)].add(dens[0])
            continue
        if rel.lower().endswith(".svg") or ".imageset/" in rel or ".appiconset/" in rel:
            continue
        stem, ext = os.path.splitext(os.path.basename(rel))
        fm = FLUTTER_SCALE.search(rel)
        if fm:
            flutter[(FLUTTER_SCALE.sub(r"\1", rel))].add(fm.group(2))
            continue
        m = AT_SCALE.match(stem)
        groups[(os.path.dirname(rel), m.group(1) if m else stem, ext)].add(m.group(2) if m else "1")
        flutter.setdefault(rel, set())
    for (folder, stem, ext), scales in sorted(groups.items()):
        if scales & {"2", "3"} and not {"2", "3"} <= scales:
            gaps.append({"asset": "%s/%s%s" % (folder, stem, ext) if folder else stem + ext, "has": sorted("@%sx" % s for s in scales),
                         "missing": sorted("@%sx" % s for s in {"2", "3"} - scales)})
    flutter_dirs = {os.path.dirname(k) for k, v in flutter.items() if v}
    for rel, scales in sorted(flutter.items()):
        if (scales and not {"2", "3"} <= scales) or (not scales and os.path.dirname(rel) in flutter_dirs):
            gaps.append({"asset": rel, "has": sorted("%s.0x" % s for s in scales) or ["1.0x"],
                         "missing": sorted("%s.0x" % s for s in {"2", "3"} - scales)})
    for (base, kind, night, name), dens in sorted(android.items()):
        want = DENSITIES if kind == "mipmap" else android_used[(base, kind)]
        missing = [d for d in DENSITIES if d in want and d not in dens]
        if missing:
            gaps.append({"asset": "%s/res/%s%s/%s" % (base, kind, "-night" if night else "", name), "has": sorted(dens, key=DENSITIES.index),
                         "missing": missing})
    for rel in listing:
        if rel.endswith(".imageset/Contents.json"):
            try:
                spec = json.loads(read_text(root, rel) or "{}")
            except ValueError:
                continue
            entries = [e for e in spec.get("images", []) if isinstance(e, dict)]
            files = [e for e in entries if e.get("filename")]
            vector = any(str(e.get("filename", "")).lower().endswith((".pdf", ".svg")) for e in files)
            missing = sorted({e.get("scale") for e in entries if e.get("scale") in ("2x", "3x") and not e.get("filename")})
            if not files:
                gaps.append({"asset": os.path.dirname(rel), "has": [], "missing": ["mọi ảnh"]})
            elif missing and not vector:
                gaps.append({"asset": os.path.dirname(rel), "has": sorted(e.get("scale", "?") for e in files), "missing": missing})
    out["density_gaps"] = {"count": len(gaps), "top": gaps[:n]}
    unused = []
    for rel in images:
        if IDENTITY_PATH.search(rel) or rel.rsplit("/", 1)[-1] in ("Contents.json",):
            continue
        if not any(name and name in blob for name in asset_names(rel)):
            unused.append(rel)
    out["unused"] = {"count": len(unused), "top": unused[:n]}
    missing = []
    for rel, text in sources:
        for m in ASSET_REF.finditer(text):
            spec = next(g for g in m.groups() if g)
            if spec.startswith(("http:", "https:", "data:")):
                continue
            if spec.startswith("."):
                cands = [os.path.normpath(os.path.join(os.path.dirname(rel), spec)).replace("\\", "/")]
            elif spec.startswith("/"):
                base = nearest(rel, "public", dirs)
                cands = [((base + "/") if base else "") + "public" + spec] if base is not None else [spec.lstrip("/")]
            elif spec.startswith(("@/", "~/")):
                parts = rel.split("/")
                cands = ["/".join(parts[:parts.index("src") + 1]) + "/" + spec[2:]] if "src" in parts else [spec[2:]]
            else:
                base = nearest(rel, "pubspec.yaml", dirs)
                cands = [((base + "/") if base else "") + spec]
            if not any(asset_exists(root, known, cand) for cand in cands):
                missing.append({"ref": spec, "at": "%s:%d" % (rel, line_of(text, m.start()))})
    out["missing"] = missing[:n]
    return out


def identity_report(root, listing, blob):
    known = set(listing)
    out = {}

    def has(rx):
        return [p for p in listing if re.search(rx, p)]

    if has(r"\.xcodeproj/|AppIcon[^/]*\.appiconset/"):
        missing = []
        icon = has(r"AppIcon[^/]*\.appiconset/Contents\.json$")
        if not icon:
            missing.append("AppIcon.appiconset")
        else:
            try:
                spec = json.loads(read_text(root, icon[0]) or "{}")
            except ValueError:
                spec = {}
            entries = [e for e in spec.get("images", []) if isinstance(e, dict)]
            if not any(e.get("filename") and str(e.get("size", "")).startswith("1024") for e in entries):
                missing.append("app icon 1024×1024 (App Store)")
            empty = [e for e in entries if not e.get("filename")]
            if empty and len(entries) > 1 and len(empty) < len(entries):
                missing.append("app icon thiếu %d/%d cỡ" % (len(empty), len(entries)))
        plists = " ".join(read_text(root, p) or "" for p in has(r"(^|/)Info\.plist$")[:4])
        if not has(r"LaunchScreen\.storyboard$") and "UILaunchScreen" not in plists and "UILaunchStoryboardName" not in plists:
            missing.append("launch screen")
        out["ios"] = {"missing": missing}
    manifests = has(r"(^|/)src/main/AndroidManifest\.xml$")
    if manifests:
        missing = []
        base = manifests[0].split("/src/main/")[0]
        launcher = {re.search(r"mipmap-(\w+)/", p).group(1) for p in has(r"%s/src/main/res/mipmap-\w+/ic_launcher[^/]*\.(png|webp)$" % re.escape(base))}
        lacking = [d for d in DENSITIES if d not in launcher]
        if lacking:
            missing.append("ic_launcher %s" % ", ".join(lacking))
        if not has(r"res/mipmap-anydpi-v26/ic_launcher\.xml$"):
            missing.append("adaptive icon (mipmap-anydpi-v26)")
        styles = " ".join(read_text(root, p) or "" for p in has(r"%s/src/main/res/values[^/]*/(styles|themes)\.xml$" % re.escape(base)))
        background = " ".join(re.sub(r"<!--.*?-->", "", read_text(root, p) or "", flags=re.S) for p in has(r"launch_background\.xml$"))
        if "windowSplashScreen" not in styles and "<bitmap" not in background and not has(r"res/drawable[^/]*/splash"):
            missing.append("splash (windowSplashScreen hoặc launch_background có ảnh)")
        out["android"] = {"missing": missing}
    for rel in has(r"(^|/)app\.json$"):
        try:
            expo = (json.loads(read_text(root, rel) or "{}") or {}).get("expo")
        except ValueError:
            continue
        if not isinstance(expo, dict):
            continue
        base = os.path.dirname(rel)
        missing = []
        plugins = json.dumps(expo.get("plugins") or [])
        checks = [("icon", expo.get("icon")), ("splash", (expo.get("splash") or {}).get("image") or ("expo-splash-screen" in plugins and "x")),
                  ("android.adaptiveIcon", ((expo.get("android") or {}).get("adaptiveIcon") or {}).get("foregroundImage")),
                  ("web.favicon", (expo.get("web") or {}).get("favicon"))]
        for key, value in checks:
            if not value:
                missing.append(key)
            elif value != "x" and os.path.normpath(os.path.join(base, value)).replace("\\", "/") not in known:
                missing.append("%s (%s không có)" % (key, value))
        out["expo"] = {"missing": missing}
        break
    packages = " ".join(read_text(root, p) or "" for p in has(r"(^|/)package\.json$")[:6])
    if re.search(r"\"(next|vite|react-scripts|nuxt|@sveltejs/kit|@angular/core|astro)\"", packages):
        missing = []
        if not has(r"(^|/)(public|static|app|src/app)/(favicon\.(ico|png|svg)|icon\.(png|svg|ico|tsx?|jsx?))$") \
                and not re.search(r"rel=[\"'](?:shortcut )?icon[\"']", blob):
            missing.append("favicon")
        if not has(r"(^|/)(apple-touch-icon[^/]*\.png|apple-icon\.(png|tsx?|jsx?))$") and "apple-touch-icon" not in blob:
            missing.append("apple-touch-icon")
        if not has(r"(^|/)(manifest\.json|site\.webmanifest|manifest\.webmanifest|manifest\.(ts|js))$"):
            missing.append("web manifest (icon 192/512)")
        if not has(r"(^|/)(opengraph-image|og-image|og)\.\w+$") and "og:image" not in blob and "openGraph" not in blob:
            missing.append("ảnh chia sẻ (og:image)")
        out["web"] = {"missing": missing}
    out["template_leftovers"] = [{"path": rel, "used": os.path.basename(rel) in blob} for rel in listing
                                 if any(rel == t or rel.endswith("/" + t) for t in TEMPLATE_LEFTOVERS)]
    return out


def font_families(root, listing, sources, styles, blob):
    """Brand fonts the product declares: next/font, @font-face, pubspec fonts, Google Fonts links, google_fonts."""
    found = set()
    for _, text in sources:
        for m in re.finditer(r"import\s*\{([^}]+)\}\s*from\s*['\"]next/font/google['\"]", text):
            found.update(f.strip().split(" as ")[0] for f in m.group(1).split(",") if f.strip())
    sheets = " ".join(t for _, t in styles)
    found.update(re.findall(r"@font-face\s*\{[^}]*?font-family:\s*['\"]?([A-Za-z][\w -]+?)['\"]?\s*;", sheets))
    pubspecs = " ".join(read_text(root, p) or "" for p in listing if p.endswith("pubspec.yaml"))
    found.update(f.strip() for f in re.findall(r"-\s*family:\s*([\w -]+)", pubspecs))
    found.update(f.replace("+", " ") for f in re.findall(r"fonts\.googleapis\.com/css2?\?family=([A-Za-z+]+)", blob))
    found.update(re.findall(r"\bGoogleFonts\.(\w+)\(", blob))
    return sorted(found)


def cmd_ready(a):
    root, cfg = context()
    paths = scope(cfg, a.paths)
    listing = tracked(root, paths, cfg)
    code = Code(root, paths, cfg)
    sig = Signals()
    ui, sources = {}, []
    for rel, lang, text in code.source():
        sources.append((rel, text))
        if ui_file(rel, lang, text):
            ui[rel] = (lang, text)
    styles = [(rel, read_text(root, rel) or "") for rel in listing if rel.lower().endswith(STYLE_EXT)]
    blob_parts = []
    for rel in listing:
        ext = os.path.splitext(rel)[1].lower()
        if ext in TEXT_EXT and not rel.endswith(("pubspec.yaml", "Contents.json")) and rel not in code.files:
            blob_parts.append(read_text(root, rel) or "")
    blob = "\n".join(blob_parts + [text for _, text, _ in code.files.values()])
    for name, where, pattern in PROTOTYPE:
        pool = ui.items() if where == "ui" else ((r, (None, t)) for r, t in sources)
        for rel, (_, text) in pool:
            for m in pattern.finditer(text):
                if name not in ("lorem", "placeholder_image") and in_comment(text, m.start()):
                    continue
                sig.add(name, rel, text, m.start())
    for rel in listing:
        if rel.lower().endswith((".html", ".xml", ".plist", ".json")) and not GENERATED.search(rel) and not TESTS.search(rel):
            text = read_text(root, rel) or ""
            for m in DEFAULT_TITLE.finditer(text):
                sig.add("default_title", rel, text, m.start())
    for rel, text in sources:
        for m in DEFAULT_TITLE.finditer(text):
            sig.add("default_title", rel, text, m.start())
    tokens = sorted({rel for rel in [r for r, _ in styles] + [r for r, _ in sources] if TOKEN_FILE.search(rel)})
    font_sizes, radii = collections.Counter(), collections.Counter()
    own_palette = re.search(r"\bclass\s+Colors\b", blob)  # the product's own `Colors` tokens, not Material's palette
    for rel, text in list((r, t) for r, (_, t) in ui.items()) + styles:
        if TOKEN_FILE.search(rel):
            continue
        for name, pattern in DESIGN:
            if name == "default_palette" and own_palette:
                continue
            for m in pattern.finditer(text):
                line_start = text.rfind("\n", 0, m.start()) + 1
                if in_comment(text, m.start()) or re.match(r"\s*(--[\w-]+|\$[\w-]+)\s*:", text[line_start:m.start() + 1]):
                    continue
                sig.add(name, rel, text, m.start())
        for m in FONT_SIZE.finditer(text):
            font_sizes[next(g for g in m.groups() if g)] += 1
        for m in RADIUS.finditer(text):
            radii[next(g for g in m.groups() if g)] += 1
        for m in SPACING.finditer(text):
            values = re.findall(r"(?<![\w.])\d+(?:\.\d+)?", m.group(3)) if m.group(3) else [m.group(1) or m.group(2)]
            if any(float(v) % 4 and float(v) not in (1, 2, 6) for v in values):
                sig.add("off_grid", rel, text, m.start())
        if rel.lower().endswith(STYLE_EXT):
            continue
        for m in EMOJI.finditer(text):
            if not in_comment(text, m.start()):
                sig.add("emoji", rel, text, m.start())
    icon_sets = collections.defaultdict(set)
    groups = collections.defaultdict(set)  # one UI = a scanned path × a language: Flutter and an iOS widget do not mix
    for rel, (lang, text) in list(ui.items()) + [(r, (code.files[r][0], t)) for r, t in sources if r not in ui]:
        before = {k: len(v) for k, v in icon_sets.items()}
        for m in ICON_IMPORT.finditer(text):
            names, default, module = m.group(1) or "", m.group(2), m.group(3)
            for rx, label in JS_ICON_LIBS:
                hit = rx.match(module)
                if not hit:
                    continue
                if "{0}" in label and not (hit.groups() and hit.group(1)):
                    families = [x.strip().split(" as ")[0] for x in names.split(",") if x.strip()] or [default or "?"]
                    for fam in families:
                        icon_sets[label.format(fam)].add(rel)
                else:
                    icon_sets[label.format(*(hit.groups() or ("",)))].add(rel)
        for language, rx, label in CODE_ICONS:
            if lang == language and rx.search(text):
                icon_sets[label].add(rel)
        owner = next((p for p in paths if p == "." or rel.startswith(p.rstrip("/") + "/")), ".")
        family = "js" if lang in JS_LIKE else lang
        groups[(owner, family)].update(k for k, v in icon_sets.items() if len(v) > before.get(k, 0))
    if any(re.search(r"(^|/)icons?/[^/]+\.svg$", p) for p in listing):
        icon_sets["svg riêng"].update(p for p in listing if re.search(r"(^|/)icons?/[^/]+\.svg$", p))
    l10n = any(L10N_FILE.search(p) for p in listing)
    vi, en, en_at = 0, 0, []
    for rel, (lang, text) in ui.items():
        ext = os.path.splitext(rel)[1].lower()
        for scope_, pattern in UI_TEXT:
            if ext not in scope_ and lang not in scope_:
                continue
            for m in pattern.finditer(text):
                literal = next((g for g in m.groups() if g), "").strip()
                if not literal or CODE_TEXT.search(literal) or in_comment(text, m.start()):
                    continue
                sig.add("hardcoded_text", rel, text, m.start())
                words = re.findall(r"[A-Za-z]+", literal.lower())
                if VI_CHARS.search(literal):
                    vi += 1
                elif len(words) >= 2 and set(words) & EN_WORDS:
                    en += 1
                    if len(en_at) < 5:
                        en_at.append("%s:%d %s" % (rel, line_of(text, m.start()), literal[:40]))
    screens = sorted({s["at"].rsplit(":", 1)[0] for s in (load_json(a.map).get("screens", []) if a.map else [])} & set(ui)) \
        or sorted(r for r in ui if re.search(r"(^|/)(pages?|screens?|views?|routes?|app)/|(page|screen|view)\.\w+$", r, re.I))
    known = set(code.files)
    states = {"screens": len(screens), "no_loading": [], "no_empty": [], "no_error": []}
    for rel in screens:
        text = ui[rel][1]
        joined = text + "".join(code.files[dep][1] for dep in {resolve_import(rel, s, known) for s in IMPORT_SPEC.findall(text)} - {None})
        if not FETCH.search(joined):
            continue
        for key, rx, needs in (("no_loading", LOADING, None), ("no_empty", EMPTY, LISTING), ("no_error", FAILED, None)):
            if (needs is None or needs.search(joined)) and not rx.search(joined):
                states[key].append(rel)
                sig.add(key, rel, line=None)
    manifests = " ".join(read_text(root, p) or "" for p in listing if os.path.basename(p) in MANIFESTS)
    auto = AUTO_TRACK.search(blob)
    track_at = ["%s:%d" % (rel, line_of(text, m.start())) for rel, text in sources for m in TRACK_CALL.finditer(text)
                if not in_comment(text, m.start())]
    debug = SMELLS[[s[0] for s in SMELLS].index("debug_print")][2]
    fonts = font_families(root, listing, sources, styles, blob)
    font_files = [p for p in listing if p.lower().endswith(FONT_EXT)]
    assets = assets_report(root, listing, blob, sources, a.top)
    identity = identity_report(root, listing, blob)
    leftovers = identity.pop("template_leftovers")
    dark = bool(DARK_MODE.search(blob)) or any("/values-night" in p for p in listing)
    by_area = []
    if a.map:
        for item in load_json(a.map).get("areas", []):
            if item.get("kind") != "ui":
                continue
            files = [f for f in item.get("files", []) if f in code.files]
            layer = list(files)
            for _ in range(2):  # the route file → its screen → the screen's components
                deps = sorted({resolve_import(f, s, known) for f in layer for s in IMPORT_SPEC.findall(code.files[f][1])} - {None} - set(files))
                layer = deps[:15]
                files += layer
            counts, at = collections.Counter(), []
            for f in files:
                counts.update(sig.per_file.get(f, {}))
                at += [w for k, w in sig.first.get(f, {}).items() if k in SIGNALS]
            signals = {k: counts[k] for k in SIGNALS if counts[k]}
            if signals:
                by_area.append({"area": item["area"], "files": len(files), "signals": signals, "at": at[:6]})
    emit({"root": root, "paths": paths,
          "prototype": dict(sig.report(("lorem", "coming_soon", "fake_person", "placeholder_image", "mock_data", "todo_text", "dead_handler",
                                        "raw_error", "flag_hardcoded", "default_title"), a.top),
                            template_leftovers=leftovers),
          "design_system": {"token_files": tokens[:12], "hardcoded": sig.report(("hex", "rgb", "color_literal", "default_palette",
                                                                                 "arbitrary_value", "font_family", "off_grid"), a.top),
                            "font_sizes": dict(font_sizes.most_common(12)), "radii": dict(radii.most_common(8)),
                            "icon_sets": {k: len(v) for k, v in sorted(icon_sets.items(), key=lambda kv: -len(kv[1]))},
                            "icon_mixed": {"%s (%s)" % key: sorted(sets) for key, sets in sorted(groups.items()) if len(sets) > 1}, "emoji": sig.report(("emoji",), a.top).get("emoji")},
          "assets": dict(assets, dark_mode=dark),
          "identity": identity,
          "fonts": {"files": len(font_files), "families": fonts[:8], "custom": bool(fonts or font_files)},
          "copy": {"l10n": l10n, "hardcoded_text": sig.report(("hardcoded_text",), a.top).get("hardcoded_text"),
                   "mixed_lang": {"vi": vi, "en": en, "en_at": en_at} if vi and en else None},
          "states": {k: (v[:a.top] if isinstance(v, list) else v) for k, v in states.items()},
          "ops": {"tracking": [n for n, rx in TRACK_SDK if re.search(rx, manifests, re.I)],
                  "crash_reporting": [n for n, rx in CRASH_SDK if re.search(rx, manifests, re.I)],
                  "screen_tracking": auto.group(0) if auto else None,
                  "track_calls": {"count": len(track_at), "files": len({w.rsplit(":", 1)[0] for w in track_at}), "at": track_at[:5]},
                  "debug_print": sum(len(debug.findall(t)) for r, t in sources if r in ui)},
          "areas": sorted(by_area, key=lambda x: -sum(x["signals"].values()))[:max(a.top * 3, 20)]})


# ── coverage: plan + ledger ─────────────────────────────────────────────────

COVER_HEAD = "Bản đồ phủ"
HEALTH_HEAD = "Sức khoẻ"
VERIFY_HEAD = "Xác minh sửa"
LAST = "Lần cuối"
LEVEL_HEAD = "Mức"  # readiness ux graded the last time the area was tested
LEVELS = ("Prototype", "Beta", "Production")
TESTED = ("✓", "✗", "⛔")  # pass · bug · denied as it must be; `·` not yet, `—` not for this role
LAST_RX = re.compile(r"@([0-9a-f]{7,40})\s+(\d{4}-\d{2}-\d{2})")
TICKET = re.compile(r"#(\d+)")


def section(text, head):
    m = re.search(r"^##\s+%s\b.*$" % re.escape(head), text or "", re.M)
    if not m:
        return ""
    rest = text[m.end():]
    nxt = re.search(r"^##\s", rest, re.M)
    return rest[:nxt.start()] if nxt else rest


def parse_table(block):
    """(header, rows) of the first markdown table in `block`."""
    rows = []
    for line in block.splitlines():
        line = line.strip()
        if not line.startswith("|"):
            if rows:
                break
            continue
        cells = [c.strip() for c in line.strip("|").split("|")]
        if all(re.match(r"^:?-{2,}:?$", c) for c in cells if c):
            continue
        rows.append(cells)
    return (rows[0], rows[1:]) if rows else ([], [])


def coverage_of(text):
    """{area: {"cells": {role: cell}, "sha": .., "date": ..}}, roles in table order."""
    header, rows = parse_table(section(text, COVER_HEAD))
    if not header:
        return {}, []
    roles = [h for h in header[1:] if h not in (LAST, LEVEL_HEAD)]
    out = {}
    for row in rows:
        row = row + [""] * (len(header) - len(row))
        cells = {r: (row[i + 1] or "·") for i, r in enumerate(header[1:]) if r not in (LAST, LEVEL_HEAD)}
        last = LAST_RX.search(row[header.index(LAST)]) if LAST in header else None
        level = row[header.index(LEVEL_HEAD)] if LEVEL_HEAD in header else ""
        out[row[0]] = {"cells": cells, "sha": last.group(1) if last else None, "date": last.group(2) if last else None,
                       "level": level if level in LEVELS else None}
    return out, roles


def read_file(path):
    if not path:
        return ""
    try:
        with open(path, encoding="utf-8") as fh:
            return fh.read()
    except OSError as err:
        emit({"error": "không đọc được %s: %s" % (path, err)}, 3)


def load_json(path):
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError) as err:
        emit({"error": "không đọc được %s: %s" % (path, err)}, 3)


def cmd_plan(a):
    root, _ = context()
    amap = load_json(a.map)
    prev, roles = coverage_of(read_file(a.prev))
    roles = roles or [r["role"] for r in amap.get("roles", [])][:8]
    closed = {int(n) for n in re.findall(r"\d+", a.closed or "")}
    changed_since = {}
    head = git(root, "rev-parse", "HEAD").strip()
    focus = (a.focus or "").strip().lower()
    rows = []
    for order, item in enumerate(amap.get("areas", [])):
        name, row = item["area"], prev.get(item["area"])
        if focus and focus not in name.lower() and not any(focus.strip("/") in f.lower() for f in item.get("files", [])):
            continue
        cells = row["cells"] if row else {}
        tested = any(c.startswith(TESTED) for c in cells.values())
        tickets = {int(n) for c in cells.values() if c.startswith("✗") for n in TICKET.findall(c)}
        why = None
        if tickets & closed:
            why, rank = "verify %s" % " ".join("#%d" % n for n in sorted(tickets & closed)), 0
        elif row and row["sha"]:
            sha = row["sha"]
            if sha not in changed_since:
                known = git(root, "cat-file", "-t", sha).strip() == "commit"
                changed_since[sha] = set(git(root, "diff", "--name-only", sha, head).splitlines()) if known and head else None
            diff = changed_since[sha]
            if diff and set(item.get("files", [])) & diff:
                why, rank = "changed since @%s" % sha[:7], 1
        if why is None and not tested:
            why, rank = "new", 2
        if why is None:
            why, rank = ("open bug" if tickets else "stale %s" % (row["date"] or "?")), 4 if tickets else 3
        rows.append((rank, (row or {}).get("date") or "", order, name, why, item, cells))
    rows.sort(key=lambda r: r[:3])  # reason, then the oldest test, then the map's order (screens before API)
    pick = rows if a.max <= 0 else rows[:a.max]
    ever = sum(1 for item in amap.get("areas", []) if any(c.startswith(TESTED) for c in (prev.get(item["area"]) or {}).get("cells", {}).values()))
    emit({"total": len(amap.get("areas", [])), "matched": len(rows), "covered_before": ever, "roles": roles,
          "missing_accounts": amap.get("missing_accounts", []), "env_files": amap.get("env_files", []),
          "selected": [{"area": name, "kind": item["kind"], "surface": item.get("surface"), "why": why, "files": item.get("files", [])[:3],
                        "cells": {r: cells.get(r, "·") for r in roles}, "level": (prev.get(name) or {}).get("level")}
                       for _, _, _, name, why, item, cells in pick],
          "left": len(rows) - len(pick),
          "note": "FOCUS không khớp vùng nào" if focus and not rows else None})


def cell_ticket(cell, tickets):
    """`✗ qa:F3` → `✗ #45` once the finding has its ticket."""
    def sub(m):
        return tickets.get(m.group(0), m.group(0))
    return re.sub(r"\b(?:qa|ux|arch|product):F\d+\b", sub, cell)


def cmd_ledger(a):
    amap = load_json(a.map)
    prev_text, run_text = read_file(a.prev), read_file(a.run)
    prev, prev_roles = coverage_of(prev_text)
    run, run_roles = coverage_of(run_text)
    roles = run_roles or prev_roles or [r["role"] for r in amap.get("roles", [])][:8]
    tickets = {}
    for pair in (a.tickets or "").split(","):
        if "=" in pair:
            k, v = pair.split("=", 1)
            tickets[k.strip()] = v.strip()
    sha7, date = a.sha[:7], a.date or datetime.date.today().isoformat()
    names = [i["area"] for i in amap.get("areas", [])]
    unknown = [n for n in run if n not in names]
    if unknown:  # a screen the map cannot see (no route): kept, but a typo of an area name would be a second row
        sys.stderr.write("vùng không có trong map (giữ thành dòng riêng): %s\n" % ", ".join(unknown))
    names += unknown
    index = load_json(a.index) if a.index else {}
    graded = {g["area"]: g["level"] for g in index.get("ready", [])}
    stray = sorted(n for n in graded if n not in run)
    if stray:  # only an area tested this run gets a grade: the images ux judged are of this run
        sys.stderr.write("mức của vùng không test lượt này (bỏ qua): %s\n" % ", ".join(stray))
    table, covered, roles_hit, levels = [], 0, set(), collections.Counter()
    for name in names:
        old, new = prev.get(name), run.get(name)
        cells, last = {}, ""
        level = (graded.get(name) if new else None) or (old or {}).get("level")
        if level:
            levels[level] += 1
        for r in roles:
            cell = (new or {}).get("cells", {}).get(r) or "·"
            if cell == "·" and old:
                cell = old["cells"].get(r, "·")
            cells[r] = cell_ticket(cell, tickets)
        if new:
            last = "@%s %s" % (sha7, date)
        elif old and old["sha"]:
            last = "@%s %s" % (old["sha"][:7], old["date"])
        hit = [r for r in roles if cells[r].startswith(TESTED)]
        covered += 1 if hit else 0
        roles_hit.update(hit)
        table.append("| %s | %s | %s | %s |" % (name, " | ".join(cells[r] for r in roles), level or "·", last or "—"))
    before = sum(1 for n in names if any(c.startswith(TESTED) for c in (prev.get(n) or {}).get("cells", {}).values()))
    verified = re.findall(r"#\d+\s*(✓|✗)", section(run_text, VERIFY_HEAD))
    ok, bad = verified.count("✓"), verified.count("✗")
    sev = index.get("by_sev", {})
    regressed = sum(1 for f in index.get("findings", []) if f.get("regressed"))
    total = len(names) or 1
    hist_head, hist_rows = parse_table(section(prev_text, HEALTH_HEAD))
    rated = sum(levels.values())
    production = ("%d/%d" % (levels["Production"], rated)) if rated else "—"
    row = "| %s | @%s | %d/%d (%d%%) | %d/%d | %s | %d | %d | %d | %d | %s |" % (
        date, sha7, covered, len(names), round(100.0 * covered / total), len(roles_hit), len(roles), production,
        sev.get("cao", 0), sev.get("vừa", 0), sev.get("thấp", 0), regressed, ("%d/%d" % (ok, ok + bad)) if ok + bad else "—")
    history = []
    for r in hist_rows:
        if len(r) == 9:  # a run before readiness was graded
            r = r[:4] + ["—"] + r[4:]
        if len(r) >= 10:
            history.append("| " + " | ".join(r) + " |")
    readiness = (" · mức %d Production · %d Beta · %d Prototype / %d vùng đã chấm" % (
        levels["Production"], levels["Beta"], levels["Prototype"], rated)) if rated else ""
    out = ["## %s" % HEALTH_HEAD, "",
           "Phủ vùng %d/%d → %d/%d · role đã test %d/%d (%s) · xác minh sửa %d ✓ %d ✗%s" % (
               before, len(names), covered, len(names), len(roles_hit), len(roles), ", ".join(sorted(roles_hit)) or "—", ok, bad,
               readiness), "",
           "| Ngày | @sha | Vùng đã phủ | Role | Production | Cao | Vừa | Thấp | Tái phát | Xác minh sửa |",
           "|---|---|---|---|---|---|---|---|---|---|"] + history[-9:] + [row, "",
           "## %s" % COVER_HEAD, "",
           "`✓` đạt · `✗ #n` lỗi · `⛔` bị chặn đúng quyền · `·` chưa test · `—` không áp dụng · Mức: Prototype · Beta · Production "
           "(ux chấm vùng test lượt đó)", "",
           "| Vùng | %s | %s | %s |" % (" | ".join(roles), LEVEL_HEAD, LAST), "|---|%s---|---|" % ("---|" * len(roles))] + table
    print("\n".join(out))


# ── findings ────────────────────────────────────────────────────────────────

FINDING = re.compile(r"^## (F\d+)\.\s+(.+?)\s*$", re.M)
META = re.compile(r"^- (\w+):\s*(.*?)\s*$")
LENS_ORDER = ("qa", "ux", "product", "arch")  # the order the panel speaks in a merged ticket
LENS = re.compile(r"^# audit (qa|ux|arch|product)\b", re.M)
TYPES = ("Bug", "Improvement", "Feature", "Task")
SEV = {"cao": 0, "high": 0, "vừa": 1, "medium": 1, "thấp": 2, "low": 2}
SEV_NAME = {0: "cao", 1: "vừa", 2: "thấp"}
EFFORT = {"S": 0, "M": 1, "L": 2}
FP = re.compile(r"^(qa|ux|arch|product)(/[a-z0-9][a-z0-9._-]*){2,}$")
TARGET = re.compile(r"^(qa|ux|arch|product):F\d+$")
REQUIRED = ("fp", "type", "sev", "effort", "evidence")
READY = ("prototype", "beta")  # `- ready:` a finding that keeps its area from production, at that level
READY_HEAD = "Mức sẵn sàng"
CITE = re.compile(r"\b(?:qa|ux|arch|product):F\d+\b")
BODY_MAX = 8000
EXTEND_MAX = 2500  # an expert's view added to another finding: a section, not a second ticket


def parse_findings(path, platforms):
    try:
        with open(path, encoding="utf-8") as fh:
            text = fh.read()
    except OSError as err:
        return [], [{"file": path, "error": str(err)}]
    head = LENS.search(text)
    lens = head.group(1) if head else None
    heads = list(FINDING.finditer(text))
    out, errors, seen = [], [], set()
    if not head:
        errors.append({"file": path, "error": "thiếu dòng đầu `# audit <qa|ux|arch|product> · …`"})
    for i, m in enumerate(heads):
        block = text[m.end():heads[i + 1].start() if i + 1 < len(heads) else len(text)].strip("\n").split("\n")
        meta, j = {}, 0
        while j < len(block) and META.match(block[j]):
            key, value = META.match(block[j]).groups()
            meta[key] = value
            j += 1
        body = re.split(r"^## ", "\n".join(block[j:]), flags=re.M)[0].strip()  # a later `## …` section belongs to the file
        fid = "%s:%s" % (lens or "?", m.group(1))
        extends = meta.get("extends", "")
        required = ("evidence",) if extends else REQUIRED
        problems = ["thiếu `- %s:`" % k for k in required if not meta.get(k)]
        if extends and not TARGET.match(extends):
            problems.append("extends `%s` phải là <lens>:F<k>" % extends)
        elif extends and extends.split(":")[0] == lens:
            problems.append("extends chỉ trỏ phát hiện của lăng kính khác")
        if meta.get("type") and meta["type"] not in TYPES:
            problems.append("type phải là %s" % " | ".join(TYPES))
        if meta.get("sev") and meta["sev"].lower() not in SEV:
            problems.append("sev phải là cao | vừa | thấp")
        if meta.get("effort") and meta["effort"].upper() not in EFFORT:
            problems.append("effort phải là S | M | L")
        if meta.get("ready") and meta["ready"].lower() not in READY:
            problems.append("ready phải là prototype | beta")
        fp = meta.get("fp", "")
        if fp and not FP.match(fp):
            problems.append("fp `%s` phải là <lens>/<vùng>/<slug>, chữ thường, không số dòng" % fp)
        elif fp and lens and not fp.startswith(lens + "/"):
            problems.append("fp `%s` phải bắt đầu bằng `%s/`" % (fp, lens))
        plats = [p.strip() for p in meta.get("platform", "").split(",") if p.strip()]
        bad = [p for p in plats if platforms and p not in platforms]
        if bad:
            problems.append("platform %s không phải key của labels.platform (%s)" % (",".join(bad), ",".join(platforms)))
        if not extends and "- [ ]" not in body:
            problems.append("body thiếu tiêu chí nghiệm thu `- [ ]`")
        if extends and not body:
            problems.append("extends cần một đoạn góc nhìn (`### …`)")
        limit = EXTEND_MAX if extends else BODY_MAX
        if len(body) > limit:
            problems.append("body %d ký tự > %d — rút gọn" % (len(body), limit))
        if "agentflow:state" in body:
            problems.append("body không được chứa state block")
        if len(m.group(2)) > 90:
            problems.append("tiêu đề > 90 ký tự")
        if fid in seen:
            problems.append("trùng id %s" % m.group(1))
        seen.add(fid)
        if problems:
            errors.append({"file": path, "id": fid, "error": "; ".join(problems)})
            continue
        item = {"id": fid, "lens": lens, "title": m.group(2), "platform": plats, "evidence": meta["evidence"], "body": body,
                "roles": [r.strip() for r in meta.get("role", "").split(",") if r.strip()]}
        if extends:
            item["extends"] = extends
            if meta.get("sev"):
                item["sev"] = meta["sev"].lower()
        else:
            item.update({"type": meta["type"], "sev": meta["sev"].lower(), "effort": meta["effort"].upper(), "fp": fp})
        for key in ("regressed", "score"):
            if meta.get(key):
                item[key] = meta[key]
        if meta.get("ready"):
            item["ready"] = meta["ready"].lower()
        out.append(item)
    if head and not heads:
        errors.append({"file": path, "error": "không có mục `## F<k>. <tiêu đề>` nào"})
    return out, errors, grades_of(text, path, lens, errors)


def grades_of(text, path, lens, errors):
    """Rows of `## Mức sẵn sàng`: area · level · reason citing the findings that set it."""
    header, rows = parse_table(section(text, READY_HEAD))
    if not header:
        return []
    if lens != "ux":
        errors.append({"file": path, "error": "chỉ ux chấm `## %s`" % READY_HEAD})
        return []
    out = []
    for row in rows:
        row = row + ["", "", ""]
        level = next((lv for lv in LEVELS if lv.lower() == row[1].strip().lower()), None)
        if not level:
            errors.append({"file": path, "id": "ready:%s" % row[0], "error": "mức `%s` phải là %s" % (row[1], " | ".join(LEVELS))})
            continue
        out.append({"area": row[0], "level": level, "cites": CITE.findall(row[2]), "why": row[2], "file": path})
    return out


def stricter(a, b):
    return "prototype" if "prototype" in (a, b) else (a or b)


def resolve(cite, alias):
    """A view → the finding it extends, a merged duplicate → the one kept."""
    seen = set()
    while cite in alias and cite not in seen:
        seen.add(cite)
        cite = alias[cite]
    return cite


def level_of(items):
    """Prototype if a cited finding keeps the area a prototype, Beta if one blocks production (ready: beta, sev cao/vừa)."""
    level = "Production"
    for item in items:
        if item.get("ready") == "prototype":
            return "Prototype"
        if item.get("ready") == "beta" or SEV[item["sev"]] <= 1:
            level = "Beta"
    return level


def check_grades(grades, items, alias, errors):
    by_id = {i["id"]: i for i in items}
    out = []
    for g in grades:
        cited, missing = [], []
        for cite in g["cites"]:
            target = by_id.get(resolve(cite, alias))
            if target:
                cited.append(target)
            else:
                missing.append(cite)
        where = {"file": g["file"], "id": "ready:%s" % g["area"]}
        if missing:
            errors.append(dict(where, error="dẫn %s: không có mục đó" % ", ".join(missing)))
            continue
        if g["level"] != "Production" and not cited:
            errors.append(dict(where, error="mức %s phải dẫn ít nhất một mục (<lens>:F<k>)" % g["level"]))
            continue
        expect = level_of(cited)
        if expect != g["level"]:
            errors.append(dict(where, error="mức %s nhưng mục dẫn ra cho %s (ready prototype → Prototype; ready beta hoặc sev "
                                            "cao/vừa → Beta; còn lại Production)" % (g["level"], expect)))
            continue
        out.append({"area": g["area"], "level": g["level"], "cites": sorted({i["id"] for i in cited})})
    return out


def score_of(item):
    try:
        return float(re.sub(r"[^\d.]", "", item.get("score") or "") or 0)
    except ValueError:
        return 0.0


def join_panel(items, errors):
    """Fold every `extends` view into the finding it names: its section joins the body, its lens the panel, a higher
    sev it argues for raises the finding's."""
    by_id = {i["id"]: i for i in items if "extends" not in i}
    views = sorted((i for i in items if "extends" in i), key=lambda i: (LENS_ORDER.index(i["lens"]), i["id"]))
    for view in views:
        target = by_id.get(view["extends"])
        if not target:
            errors.append({"id": view["id"], "error": "extends %s: không có phát hiện đó (hoặc nó lỗi dạng)" % view["extends"]})
            continue
        target["body"] += "\n\n" + view["body"]
        target.setdefault("panel", [target["lens"]])
        if view["lens"] not in target["panel"]:
            target["panel"].append(view["lens"])
        target.setdefault("views", []).append(view["id"])
        if view.get("ready"):
            target["ready"] = stricter(target.get("ready"), view["ready"])
        for plat in view["platform"]:
            if plat not in target["platform"]:
                target["platform"].append(plat)
        for role in view["roles"]:
            if role not in target["roles"]:
                target["roles"].append(role)
        if view.get("sev") and SEV[view["sev"]] < SEV[target["sev"]]:
            target["sev_from"] = "%s → %s (%s)" % (target["sev"], SEV_NAME[SEV[view["sev"]]], view["id"])
            target["sev"] = SEV_NAME[SEV[view["sev"]]]
    return list(by_id.values())


def rank(item):
    """sev → regressed → seen by more experts → cheaper → RICE."""
    regressed = 0 if item.get("regressed") else 1
    return SEV[item["sev"]], regressed, -len(item.get("panel", [])), EFFORT[item["effort"]], -score_of(item), item["id"]


def cmd_findings(a):
    platforms = []
    root = afconfig.repo_root()
    if root:
        try:
            platforms = list(afconfig.platform_labels(afconfig.load_config(root) or {}))
        except ValueError:
            platforms = []
    items, errors, grades = [], [], []
    for path in a.files:
        found, bad, graded = parse_findings(path, platforms)
        items += found
        errors += bad
        grades += graded
    alias = {i["id"]: i["extends"] for i in items if "extends" in i}
    items = join_panel(items, errors)
    if a.body:
        hit = next((i for i in items if i["id"] == a.body), None)
        if not hit:
            emit({"error": "không có mục %s (đúng dạng: <lens>:F<k>)" % a.body}, 3)
        print(hit["body"])
        return
    merged = {}
    for item in sorted(items, key=lambda i: SEV[i["sev"]]):
        kept = merged.get(item["fp"])
        if kept:
            kept.setdefault("also", []).append(item["id"])
            alias[item["id"]] = kept["id"]
            if item.get("ready"):
                kept["ready"] = stricter(kept.get("ready"), item["ready"])
            continue
        merged[item["fp"]] = item
    ranked = sorted(merged.values(), key=rank)
    ready = check_grades(grades, ranked, alias, errors)
    counts = collections.Counter(i["sev"] for i in ranked)
    roles = collections.Counter(r for i in ranked for r in i["roles"])
    emit({"count": len(ranked), "by_sev": dict(counts), "by_lens": dict(collections.Counter(i["lens"] for i in ranked)),
          "by_role": dict(roles), "panel": sum(1 for i in ranked if len(i.get("panel", [])) > 1),
          "ready": ready, "by_level": dict(collections.Counter(g["level"] for g in ready)),
          "findings": [{k: v for k, v in i.items() if k != "body"} for i in ranked], "errors": errors}, 1 if errors else 0)


def main(argv=None):
    p = argparse.ArgumentParser(prog="agentflow-audit", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("scan", help="radar kiến trúc + chất lượng code")
    s.add_argument("--days", type=int, default=180, help="cửa sổ lịch sử git cho hotspot/coupling (mặc định 180)")
    s.add_argument("--top", type=int, default=12, help="số dòng tối đa mỗi danh sách")
    s.add_argument("--depth", type=int, default=3, help="số tầng thư mục dưới path làm một module (mặc định 3)")
    s.add_argument("paths", nargs="*")
    s = sub.add_parser("flows", help="kiểm kê + soát độ vững của automation e2e")
    s.add_argument("paths", nargs="*")
    s = sub.add_parser("map", help="kiểm kê toàn sản phẩm: màn, endpoint, role, tài khoản test, vùng của bản đồ phủ")
    s.add_argument("--max-areas", type=int, default=250, help="số vùng tối đa của bản đồ phủ (mặc định 250)")
    s.add_argument("paths", nargs="*")
    s = sub.add_parser("ready", help="mức sẵn sàng production: dấu vết prototype, design system, asset, nhận diện app, chữ, state")
    s.add_argument("--map", help="JSON của `map`: thêm tín hiệu theo vùng")
    s.add_argument("--top", type=int, default=8, help="số dòng tối đa mỗi danh sách")
    s.add_argument("paths", nargs="*")
    s = sub.add_parser("plan", help="vùng nên test lượt này theo bản đồ phủ lần trước")
    s.add_argument("--map", required=True, help="JSON của `map`")
    s.add_argument("--prev", help="body issue checklist lần trước (có `## Bản đồ phủ`)")
    s.add_argument("--closed", help="số ticket đã đóng, phẩy: vùng có lỗi đó cần xác minh sửa")
    s.add_argument("--focus", help="chỉ vùng có tên hoặc file chứa chuỗi này")
    s.add_argument("--max", type=int, default=15, help="số vùng tối đa (0 = tất cả; mặc định 15)")
    s = sub.add_parser("ledger", help="markdown Sức khoẻ + Bản đồ phủ cho issue checklist")
    s.add_argument("--map", required=True)
    s.add_argument("--run", help="bảng phủ của lượt này (qa viết); không có = lượt chỉ soát tĩnh")
    s.add_argument("--sha", required=True)
    s.add_argument("--prev")
    s.add_argument("--index", help="JSON của `findings` (đếm mức độ, tái phát, mức sẵn sàng của vùng)")
    s.add_argument("--tickets", help="id phát hiện → ticket, vd qa:F1=#45,ux:F2=#46")
    s.add_argument("--date")
    s = sub.add_parser("findings", help="kiểm + gộp file phát hiện của auditor")
    s.add_argument("files", nargs="+")
    s.add_argument("--body", help="in body ticket của một mục, vd qa:F2")
    a = p.parse_args(argv)
    {"scan": cmd_scan, "flows": cmd_flows, "map": cmd_map, "ready": cmd_ready, "plan": cmd_plan, "ledger": cmd_ledger, "findings": cmd_findings}[a.cmd](a)


if __name__ == "__main__":
    main()
