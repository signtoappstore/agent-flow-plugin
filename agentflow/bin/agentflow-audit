                       r"Merchant|Vendor|Driver|Customer|Member|Guest|Partner|Operator|Support)\b")
NOT_ROLE = {"string", "number", "null", "undefined", "none", "true", "false", "int", "unknown", "any", "object", "boolean"}
AUTH_SCREEN = re.compile(r"log-?in|sign-?in|sign-?up|register|auth|onboard|đăng", re.I)
ACCOUNT_KEY = re.compile(r"^(?:E2E|TEST|QA|STAGING)_(?:(\w+?)_)?(EMAIL|USER|USERNAME|LOGIN|PHONE|PASSWORD|PASS|OTP|PIN|TOKEN)$")
ACCOUNT_REF = re.compile(r"\b((?:E2E|TEST|QA|STAGING)_(?:\w+?_)?(?:EMAIL|USER|USERNAME|LOGIN|PHONE|PASSWORD|PASS|OTP|PIN|TOKEN))\b")
