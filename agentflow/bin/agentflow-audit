EMPTY = re.compile(r"isEmpty|\.length\s*===?\s*0|!\s*\w+(?:\?\.)?\.length\b|empty|ListEmptyComponent|no (?:data|results|items)|chưa có|"
                   r"không có|nothing", re.I)
FAILED = re.compile(r"isError|error|catch|onError|hasError|ErrorBoundary|retry|thử lại|failure", re.I)
TRACK_CALL = re.compile(r"\b(?:logEvent|trackEvent|logScreenView|setCurrentScreen)\(|\b(?:analytics|posthog|mixpanel|amplitude|segment)\.\w+\("
                        r"|\b(?:track|capture)\(\s*['\"]")
AUTO_TRACK = re.compile(r"FirebaseAnalyticsObserver|AnalyticsObserver|trackScreenViews|autocapture|capture_pageview|<Analytics\s*/>"
                        r"|GoogleAnalytics\b|logScreenView\(")  # one observer tracks every screen
TRACK_SDK = [("firebase-analytics", r"firebase[_-]analytics|@react-native-firebase/analytics|firebase/analytics"),
             ("posthog", r"posthog"), ("mixpanel", r"mixpanel"), ("amplitude", r"amplitude"), ("segment", r"@segment/|segment_analytics"),
             ("google-analytics", r"react-ga|gtag|googletagmanager|@next/third-parties"), ("vercel-analytics", r"@vercel/analytics"),
             ("plausible", r"plausible"), ("umami", r"umami"), ("appsflyer", r"appsflyer"), ("adjust", r"\badjust[_-]?sdk|react-native-adjust")]
CRASH_SDK = [("sentry", r"sentry"), ("crashlytics", r"crashlytics"), ("bugsnag", r"bugsnag"), ("datadog", r"datadog"),
             ("newrelic", r"newrelic|new-relic"), ("rollbar", r"rollbar"), ("instabug", r"instabug")]
L10N_FILE = re.compile(r"\.arb$|(^|/)(locales?|i18n|lang|translations|messages)/[^/]+\.(json|ya?ml|ts|js)$|(^|/)values-[a-z]{2}[^/]*/strings\.xml$"
                       r"|\.lproj/|Localizable\.(strings|xcstrings)$")
UI_TEXT = [  # (languages or extensions, pattern with group 1 = a literal a person reads)
    (UI_EXT, re.compile(r"(?<![=\-])>\s*([^<>{}\n]*?[A-Za-zÀ-ỹ]{2,}[^<>{}\n]*?)\s*<")),
    (UI_EXT, re.compile(r"\b(?:title|placeholder|label|alt|aria-label|accessibilityLabel|subtitle|buttonText|helperText|emptyText)="
                        r"[\"']([^\"'{}\n]*[A-Za-zÀ-ỹ]{2,}[^\"'{}\n]*)[\"']")),
    (("dart",), re.compile(r"\bText\(\s*['\"]([^'\"$\n]{2,})['\"]|\b(?:labelText|hintText|helperText|title|tooltip|semanticLabel|label):"
                           r"\s*(?:const\s+Text\(\s*)?['\"]([^'\"$\n]{2,})['\"]")),
    (("kotlin",), re.compile(r"\bText\(\s*(?:text\s*=\s*)?\"([^\"$\n]{2,})\"")),
    (("swift",), re.compile(r"\.text\s*=\s*\"([^\"\n]{2,})\"|setTitle\(\"([^\"\n]{2,})\"")),
]
CODE_TEXT = re.compile(r"=>|&&|\||==|;|\(|\)|^\s*[\w.]+\s*$|\b(?:void|Promise|string|number|boolean|null|undefined)\b"
                       r"|^[^a-zà-ỹ]*$|^(?:https?:|/)\S*$")  # `a > b && c < d`, a type, a lone identifier, a format like FX-XXXX: code, not copy
VI_CHARS = re.compile(r"[ăâđêôơưàáạảãằắặẳẵầấậẩẫèéẹẻẽềếệểễìíịỉĩòóọỏõồốộổỗờớợởỡùúụủũừứựửữỳýỵỷỹ]", re.I)
EN_WORDS = {"the", "your", "you", "to", "and", "of", "for", "is", "not", "no", "please", "error", "failed", "success", "save", "cancel",
            "loading", "submit", "login", "sign", "welcome", "back", "next", "continue", "delete", "edit", "add", "search", "settings",
            "profile", "home", "view", "all", "more", "done", "try", "again", "something", "went", "wrong", "are", "sure", "confirm"}
DEFAULT_TITLE = re.compile(r"Create Next App|Generated by create next app|Vite \+ (?:React|Vue|TS|Svelte|Preact)|<title>React App</title>"
