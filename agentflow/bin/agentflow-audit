    ("next", re.compile(r"(?:^|/)app/((?:.*/)?)page\.(?:tsx|jsx|ts|js|mdx)$")),
    ("svelte", re.compile(r"(?:^|/)src/routes/((?:.*/)?)\+page\.svelte$")),
    ("pages", re.compile(r"(?:^|/)pages/(.+)\.(?:tsx|jsx|vue)$")),
]
API_FILES = [
    ("next", re.compile(r"(?:^|/)app/((?:.*/)?)route\.(?:ts|js)$")),
    ("svelte", re.compile(r"(?:^|/)src/routes/((?:.*/)?)\+server\.(?:ts|js)$")),
    ("pages", re.compile(r"(?:^|/)pages/api/(.+)\.(?:ts|js)$")),
    ("supabase", re.compile(r"(?:^|/)supabase/functions/([\w-]+)/index\.(?:ts|js)$")),
]
ROUTER_FILE = re.compile(r"createBrowserRouter|createHashRouter|<Routes\b|<Route\b|RouterModule|createRouter\(|new VueRouter|"
                         r"\broutes\s*[:=]\s*\[|useRoutes\(")
SCREEN_PATTERNS = {  # language → [(kind, pattern)]: group 1 = route or screen name
    "js": [("route", re.compile(r"<Route\b[^>]*?\bpath=\{?[\"'`]([^\"'`]*)[\"'`]")),
           ("route", re.compile(r"\bpath:\s*[\"'`]([^\"'`]*)[\"'`]")),
           ("screen", re.compile(r"<\w+\.Screen\b[^>]*?\bname=\{?[\"'`]([\w .-]+)[\"'`]"))],
    "dart": [("route", re.compile(r"\b(?:GoRoute|AutoRoute|CustomRoute|GoRouteData)\((?:[^()]|\([^()]*\)){0,300}?\bpath:\s*[\"']([^\"']+)[\"']")),
             ("route", re.compile(r"[{,]\s*[\"'](/[\w/:-]*)[\"']\s*:\s*\(\w*\)\s*=>"))],
    "kotlin": [("route", re.compile(r"\bcomposable\(\s*(?:route\s*=\s*)?\"([^\"]+)\""))],
}
METHODS = "get|post|put|patch|delete"
API_PATTERNS = [  # languages, pattern: group(method), group(path)
    (JS_LIKE + ("dart",), re.compile(r"\b(?:app|router|route|routes|api|server|r|fastify)\.(%s)\(\s*[\"'`](/[^\"'`]*)[\"'`]" % METHODS)),
    (("py",), re.compile(r"@\w+\.(%s|route|api_route)\(\s*[\"'](/[^\"']*)[\"']" % METHODS)),
    (("go",), re.compile(r"\.(GET|POST|PUT|PATCH|DELETE|Get|Post|Put|Patch|Delete|HandleFunc|Handle)\(\s*\"(/[^\"]*)\"")),
]
DART_ROUTE_IDENT = re.compile(r"\b(?:GoRoute|AutoRoute|CustomRoute)\((?:[^()]|\([^()]*\)){0,300}?\bpath:\s*(?:[A-Z]\w*\.)?([a-z_]\w*)(\.substring\(1\))?")
DART_CONST = re.compile(r"\b(?:static\s+)?const\s+(?:String\s+)?([a-zA-Z_]\w*)\s*=\s*[\"']([^\"']*)[\"']")
NEST_CTRL = re.compile(r"@Controller\(\s*(?:[\"'`]([^\"'`]*)[\"'`])?")
NEST_ROUTE = re.compile(r"@(Get|Post|Put|Patch|Delete)\(\s*(?:[\"'`]([^\"'`]*)[\"'`])?\s*\)")
SPRING_CLASS = re.compile(r"@RequestMapping\(\s*(?:value\s*=\s*|path\s*=\s*)?\{?\s*\"([^\"]*)\"[^)]*\)\s*(?:@\w+(?:\([^)]*\))?\s*)*(?:public\s+|open\s+|internal\s+)?(?:abstract\s+)?class\b")
SPRING_ROUTE = re.compile(r"@(Get|Post|Put|Patch|Delete|Request)Mapping\(\s*(?:value\s*=\s*|path\s*=\s*)?\{?\s*\"([^\"]*)\"")
DJANGO = re.compile(r"\b(?:re_)?path\(\s*r?[\"']([^\"']*)[\"']")
NEXT_METHOD = re.compile(r"export\s+(?:async\s+)?(?:function|const)\s+(GET|POST|PUT|PATCH|DELETE)\b")
AUTH_HINT = re.compile(r"auth|guard|role|permission|protect|require_?user|login_required|authorize|isAuthenticated|jwt|session|"
                       r"policy|acl|admin", re.I)
# Who a user is, not what a thing is: `SlotRole`, `ExerciseRole`, `PushPermission` name no actor.
ROLE_WORD = (r"(?:User|App|Member|Account|Staff|Team|Org|Organization|Gym|Brand|Shop|Store|Auth|Access|Platform|System|"
             r"Workspace|Project|Group|Tenant|Customer|Partner|Admin)?Roles?|(?:User|Account|Member|Actor)(?:Type|Kind)")
