TEMPLATE_LEFTOVERS = {"public/vite.svg", "src/assets/react.svg", "public/next.svg", "public/vercel.svg", "public/file.svg", "public/globe.svg",
                      "public/window.svg", "src/logo.svg", "public/logo192.png", "public/logo512.png", "assets/images/react-logo.png",
