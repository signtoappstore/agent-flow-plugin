SCREEN_PATTERNS = {  # language → [(kind, pattern)]: group 1 = route or screen name
    "js": [("route", re.compile(r"<Route\b[^>]*?\bpath=\{?[\"'`]([^\"'`]*)[\"'`]")),
           ("route", re.compile(r"\bpath:\s*[\"'`]([^\"'`]*)[\"'`]")),
           ("screen", re.compile(r"<\w+\.Screen\b[^>]*?\bname=\{?[\"'`]([\w .-]+)[\"'`]"))],
    "dart": [("route", re.compile(r"\b(?:GoRoute|AutoRoute|CustomRoute|GoRouteData)\((?:[^()]|\([^()]*\)){0,300}?\bpath:\s*[\"']([^\"']+)[\"']")),
